{
  // Configuración de Cloudflare Pages. `npm run dev` también la usa
  // (platformProxy) para crear D1 y R2 locales en .wrangler/state.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feria-4-vientos",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feria-4-vientos",
      "database_id": "9527b321-3c07-4ffb-a941-f7cab6ec3aae"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "feria-4-vientos-media"
    }
  ],
  // ADMIN_USER, ADMIN_PASSWORD (y opcional SESSION_SECRET) NO van aquí: se crean como
  // *secrets* en Cloudflare Pages → Settings → Variables and Secrets.
  "vars": {}
}
