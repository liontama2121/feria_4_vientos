---
// Una sección por viento (conjunto), con su color pleno. Los emprendedores NO se mezclan:
// cada uno aparece en la sección de su conjunto.
import EmprendedorCard from './EmprendedorCard.astro';
import type { EmprendedorPublico, Torre } from '../lib/db';
import { MENSAJES, linkWhatsApp } from '../lib/sitio';

interface Props {
  torre: Torre;
  emprendedores: EmprendedorPublico[];
}
const { torre, emprendedores } = Astro.props;
const n = emprendedores.length;
---

<section class="torre-section" id={torre.id} style={`--t:${torre.color_hex};--t-claro:${torre.color_claro}`}>
  <div class="wrap">
    <div class="torre-header">
      <div>
        <span class="eyebrow"><span class="dot"></span> {torre.rumbo}{torre.caracter && ` · ${torre.caracter}`}</span>
        <h2>{torre.nombre}</h2>
        {torre.tagline && <p class="tagline">{torre.tagline}</p>}
      </div>
      <div class="conteo-grande">
        <div class="n">{n}</div>
        <div class="l">{n === 1 ? 'Emprendedor' : 'Emprendedores'}</div>
      </div>
    </div>

    {
      n > 0 ? (
        <div class="emp-grid">
          {emprendedores.map((e) => (
            <EmprendedorCard e={e} torre={torre} />
          ))}
        </div>
      ) : (
        <div class="vacio">
          <span class="vacio-emoji">{torre.emoji_simbolo}</span>
          <div>
            <h3>{torre.nombre} está esperando su primer emprendimiento</h3>
            <p>¿Vives en {torre.nombre} y tienes un negocio? Escríbele al comité y te publicamos.</p>
          </div>
          <a class="vacio-cta" href={linkWhatsApp(MENSAJES.participar)} target="_blank" rel="noopener">
            Quiero estar aquí
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .torre-section {
    position: relative; overflow: hidden;
    padding: 110px 0;
    background: linear-gradient(180deg, var(--t-claro) 0%, color-mix(in srgb, var(--t-claro) 45%, #fff) 100%);
    scroll-margin-top: 60px;
  }
  .torre-section::before {
    content: ''; position: absolute; top: 20%; right: -10%;
    width: 500px; height: 500px; border-radius: 50%;
    background: color-mix(in srgb, var(--t) 45%, var(--t-claro));
    filter: blur(100px); opacity: .5;
    pointer-events: none;
  }
  .torre-header { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; margin-bottom: 44px; }
  @media (max-width: 720px) { .torre-header { grid-template-columns: 1fr; gap: 16px; } }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 14px; margin-bottom: 16px; border-radius: 999px; background: #fff;
    font-family: var(--display); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
  }
  .eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--t); }
  h2 { font-size: clamp(52px, 7.5vw, 104px); letter-spacing: -.045em; line-height: .95; color: var(--t); }
  .tagline { font-family: var(--serif); font-style: italic; font-size: 25px; line-height: 1.25; margin-top: 12px; max-width: 420px; }
  .conteo-grande { font-family: var(--display); text-align: right; }
  @media (max-width: 720px) { .conteo-grande { text-align: left; } }
  .conteo-grande .n { font-size: 68px; font-weight: 800; letter-spacing: -.04em; line-height: 1; color: var(--t); }
  .conteo-grande .l { font-size: 13px; font-weight: 700; color: var(--tinta-suave); letter-spacing: .12em; text-transform: uppercase; margin-top: 6px; }

  .emp-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  @media (max-width: 760px) { .emp-grid { grid-template-columns: 1fr; } }

  .vacio {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 22px; flex-wrap: wrap;
    background: rgba(255, 255, 255, .75); border: 2px dashed color-mix(in srgb, var(--t) 35%, transparent);
    border-radius: var(--radio); padding: 28px;
  }
  .vacio > div { flex: 1; min-width: 220px; }
  .vacio-emoji { font-size: 48px; }
  .vacio h3 { font-size: 19px; margin-bottom: 4px; }
  .vacio p { color: var(--tinta-media); font-size: 14.5px; }
  .vacio-cta { font-family: var(--display); font-weight: 700; font-size: 14px; padding: 12px 20px; border-radius: 999px; background: var(--t); color: #fff; }
</style>
