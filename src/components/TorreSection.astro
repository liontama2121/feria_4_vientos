---
// Solo con feria activa: una sección por conjunto (viento) con los que están EN LA FERIA.
// El nombre va en una tira rasgada de su cartulina; los avisos, pegados debajo.
import EmprendedorCard from './EmprendedorCard.astro';
import type { EmprendedorPublico, Torre } from '../lib/db';

interface Props {
  torre: Torre;
  emprendedores: EmprendedorPublico[];
}
const { torre, emprendedores } = Astro.props;
const n = emprendedores.length;
---

<section class="conjunto-seccion" id={torre.id} data-conjunto={torre.id} aria-labelledby={`t-${torre.id}`}>
  <div class="wrap">
    <div class="cabecera con-sombra">
      <div class="hoja rasgado-ambos cabecera-papel">
        <h2 id={`t-${torre.id}`}>{torre.nombre}</h2>
        <div class="datos">
          <p class="sello">{torre.rumbo}</p>
          {torre.tagline && <p class="tagline">{torre.tagline}</p>}
        </div>
        <p class="conteo">
          <span class="n">{n}</span>
          <span class="sello">en la feria</span>
        </p>
      </div>
    </div>

    {
      n > 0 ? (
        <div class="avisos">
          {emprendedores.map((e, i) => (
            <div style={`--r:${[-1.2, 0.8, -0.5, 1.4][i % 4]}deg`}>
              <EmprendedorCard e={e} torre={torre} />
            </div>
          ))}
        </div>
      ) : (
        <div class="vacio">
          <p class="vacio-titulo">{torre.nombre} aún no tiene avisos en la feria</p>
          <p>
            ¿Vives en {torre.nombre} y tienes un negocio? Regístrate y el comité te suma. Mira también <a href="#directorio">todo el muro</a>.
          </p>
          <a class="boton boton-tinta" href="/registro">
            Quiero estar aquí
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .conjunto-seccion { padding: 40px 0 90px; scroll-margin-top: 64px; }
  .cabecera { margin-bottom: 40px; }
  .cabecera-papel {
    --borde-alto: 16px;
    display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: end;
    padding: 34px 32px 30px;
    transform: rotate(-.8deg);
  }
  @media (max-width: 760px) { .cabecera-papel { grid-template-columns: 1fr; gap: 12px; padding: 30px 20px 26px; } }
  h2 { font-size: clamp(72px, 11vw, 160px); }
  .datos .sello { font-size: 14px; margin-bottom: 6px; }
  .tagline { font-size: 18px; line-height: 1.4; max-width: 44ch; }
  .conteo { display: flex; align-items: baseline; gap: 8px; }
  .n { font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 84px; line-height: .8; font-variant-numeric: tabular-nums; }

  .avisos { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 38px 28px; align-items: start; }
  @media (max-width: 700px) { .avisos { grid-template-columns: 1fr; } }

  .vacio { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 28px; background: var(--papel); border: 3px dashed var(--xerox); max-width: 720px; }
  .vacio-titulo { font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 38px; text-transform: uppercase; line-height: .9; }
  .vacio a:not(.boton) { text-decoration: underline; font-weight: 700; }
</style>
