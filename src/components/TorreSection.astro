---
// Solo con feria activa: una sección por conjunto con los que están EN LA FERIA.
// Cabecera = el pasillo del conjunto con su toldo; debajo, sus puestos.
import EmprendedorCard from './EmprendedorCard.astro';
import type { EmprendedorPublico, Torre } from '../lib/db';

interface Props {
  torre: Torre;
  emprendedores: EmprendedorPublico[];
}
const { torre, emprendedores } = Astro.props;
const n = emprendedores.length;
---

<section class="conjunto-seccion" id={torre.id} data-conjunto={torre.id} aria-labelledby={`t-${torre.id}`}>
  <div class="wrap">
    <div class="cabecera">
      <div class="toldo" aria-hidden="true"></div>
      <div class="cab-cuerpo">
        <h2 id={`t-${torre.id}`}>{torre.nombre}</h2>
        <div class="datos">
          <p class="rumbo">{torre.rumbo}</p>
          {torre.tagline && <p class="tagline">{torre.tagline}</p>}
        </div>
        <p class="etiqueta conteo">{n} en la feria</p>
      </div>
    </div>

    {
      n > 0 ? (
        <div class="lista lista-compacta">
          {emprendedores.map((e) => (
            <EmprendedorCard e={e} torre={torre} />
          ))}
        </div>
      ) : (
        <div class="vacio letrero">
          <p class="vacio-titulo">{torre.nombre} aún no tiene puestos en la feria</p>
          <p>
            ¿Vive en {torre.nombre} y tiene un negocio? <a href="/registro">Regístrese</a> y el comité lo suma. Mire también <a href="#muro">todos los puestos</a>.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .conjunto-seccion { padding: 0 0 80px; scroll-margin-top: 64px; }
  .cabecera { border-radius: var(--r-puesto); overflow: hidden; background: var(--c); color: #fff; margin-bottom: 28px; box-shadow: var(--sombra); }
  .cabecera .toldo { --t1: var(--c); --t2: #fff; }
  .cab-cuerpo { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; padding: 14px 32px 28px; }
  @media (max-width: 760px) { .cab-cuerpo { grid-template-columns: 1fr; gap: 10px; padding: 10px 20px 24px; } }
  h2 { font-size: clamp(56px, 8vw, 112px); }
  .rumbo { font-weight: 800; margin-bottom: 4px; }
  .tagline { font-size: 18px; line-height: 1.4; max-width: 44ch; }
  .conteo { transform: rotate(-3deg); }
  .lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 34px 26px; align-items: start; }
  @media (max-width: 640px) { .lista { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; align-items: stretch; } }
  .vacio { padding: 22px 24px; max-width: 760px; font-size: 17px; }
  .vacio-titulo { font-family: var(--f-letrero); font-size: 30px; line-height: 1; margin-bottom: 8px; }
  .vacio a { text-decoration: underline; font-weight: 700; }
</style>
