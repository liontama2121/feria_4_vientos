---
import Molinete from './Molinete.astro';
import type { Torre } from '../lib/db';
import { MENSAJES, SITIO, linkWhatsApp } from '../lib/sitio';

interface Props {
  torres: Torre[];
  feria: boolean;
}
const { torres, feria } = Astro.props;
const anio = 2026;
const rumbo = (t: Torre) => t.rumbo.replace(/^(Torre|Conjunto)\s+/i, '').replace(/^./, (c) => c.toUpperCase());
---

<footer class="footer">
  <div class="toldo" style="--t1:var(--mango);--t2:var(--tinta)" aria-hidden="true"></div>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-marca"><Molinete size={40} /> 4 Vientos</div>
        <p class="foot-texto">
          Feria de emprendimientos de los residentes de los {SITIO.conjunto}: {torres.map((t) => t.nombre).join(', ')}. Un espacio recuperado por y para la comunidad.
        </p>
      </div>
      <nav aria-label="Los 4 conjuntos">
        <h2 class="foot-titulo">Los 4 conjuntos</h2>
        <ul>
          {
            torres.map((t) => (
              <li>
                <a href={feria ? `/#${t.id}` : '/#directorio'} data-conjunto={t.id}>
                  <span class="punto" aria-hidden="true" />
                  {t.nombre} · {rumbo(t)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Contacto">
        <h2 class="foot-titulo">Contacto</h2>
        <ul>
          <li><a href={linkWhatsApp(MENSAJES.general)} target="_blank" rel="noopener">WhatsApp del comité</a></li>
          <li><a href={`https://instagram.com/${SITIO.instagram}`} target="_blank" rel="noopener">Instagram @{SITIO.instagram}</a></li>
          <li><a href="/registro">Registrar mi emprendimiento</a></li>
          <li><a href="/admin">Panel del comité</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-bottom">
      <p>© {anio} Feria 4 Vientos · Con el respaldo de la Alcaldía Local</p>
      <p class="firma-jc">
        Sitio web hecho con amor por JuanCode
        {
          SITIO.juancodeUrl && (
            <a class="cotiza" href={SITIO.juancodeUrl} target="_blank" rel="noopener">
              Cotice su página web
            </a>
          )
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { background: linear-gradient(var(--papel) 0 16px, var(--tinta) 16px); color: #EDEAF5; padding: 0 0 36px; }
  .footer .toldo { transform: scaleY(-1); margin-bottom: 40px; }
  .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
  @media (max-width: 800px) { .foot-grid { grid-template-columns: 1fr; gap: 30px; } }
  .foot-marca { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; font-family: var(--f-letrero); font-size: 32px; line-height: 1; }
  .foot-texto { font-size: 16px; line-height: 1.55; max-width: 48ch; color: #D6D1E4; }
  .foot-titulo { font-size: 24px; margin-bottom: 12px; color: var(--mango); }
  ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  ul a { display: inline-flex; align-items: center; gap: 10px; min-height: 36px; font-size: 16px; font-weight: 600; }
  ul a:hover { color: var(--mango); text-decoration: underline; }
  .punto { width: 12px; height: 12px; border-radius: 50%; background: var(--c); flex: 0 0 auto; }
  .foot-bottom { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding-top: 20px; border-top: 1px solid #3E3563; font-size: 14px; color: #D6D1E4; }
  .firma-jc { display: flex; gap: 14px; flex-wrap: wrap; align-items: baseline; color: #fff; }
  .cotiza { color: var(--mango); text-decoration: underline; }
  @media (max-width: 600px) { .foot-bottom { padding-right: 76px; } }
</style>
