---
import Molinete from './Molinete.astro';
import type { Torre } from '../lib/db';
import { MENSAJES, SITIO, linkWhatsApp } from '../lib/sitio';

interface Props {
  torres: Torre[];
  feria: boolean;
}
const { torres, feria } = Astro.props;
const anio = 2026;
const rumbo = (t: Torre) => t.rumbo.replace(/^(Torre|Conjunto)\s+/i, '').replace(/^./, (c) => c.toUpperCase());
---

<footer class="footer">
  <div class="wrap">
    <p class="lema" aria-hidden="true">Un muro. Cuatro vientos.</p>
    <div class="foot-grid">
      <div>
        <div class="foot-marca"><Molinete size={40} /> 4 Vientos</div>
        <p class="foot-texto">
          Feria de emprendimientos de los residentes de los {SITIO.conjunto}: {torres.map((t) => t.nombre).join(', ')}. Un espacio recuperado por y para la comunidad.
        </p>
      </div>
      <nav aria-label="Los 4 conjuntos">
        <h2 class="foot-titulo">Los 4 conjuntos</h2>
        <ul>
          {
            torres.map((t) => (
              <li>
                <a href={feria ? `/#${t.id}` : '/#directorio'} data-conjunto={t.id}>
                  <span class="marca-conjunto" aria-hidden="true" />
                  {t.nombre} · {rumbo(t)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Contacto">
        <h2 class="foot-titulo">Contacto</h2>
        <ul>
          <li><a href={linkWhatsApp(MENSAJES.general)} target="_blank" rel="noopener">WhatsApp del comité</a></li>
          <li><a href={`https://instagram.com/${SITIO.instagram}`} target="_blank" rel="noopener">Instagram @{SITIO.instagram}</a></li>
          <li><a href="/registro">Registrar mi emprendimiento</a></li>
          <li><a href="/admin">Panel del comité</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-bottom sello">
      <p>© {anio} Feria 4 Vientos · Con el respaldo de la Alcaldía Local</p>
      <p class="firma-jc">
        Sitio web hecho con amor por JuanCode
        {
          SITIO.juancodeUrl && (
            <a class="cotiza" href={SITIO.juancodeUrl} target="_blank" rel="noopener">
              Cotiza tu página web
            </a>
          )
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--xerox); color: var(--papel); padding: 56px 0 36px; }
  .lema {
    font-family: var(--f-display); font-stretch: 62%; font-weight: 900; text-transform: uppercase;
    font-size: clamp(56px, 10vw, 150px); line-height: .85; color: var(--verde);
    margin-bottom: 48px;
  }
  .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; margin-bottom: 44px; }
  @media (max-width: 800px) { .foot-grid { grid-template-columns: 1fr; gap: 30px; } }
  .foot-marca {
    display: flex; align-items: center; gap: 12px; margin-bottom: 14px;
    font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 36px; text-transform: uppercase; line-height: 1;
  }
  .foot-texto { font-size: 15.5px; line-height: 1.55; max-width: 48ch; color: #D9D6CA; }
  .foot-titulo { font-size: 30px; margin-bottom: 12px; color: var(--papel); }
  ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  ul a { display: inline-flex; align-items: center; gap: 10px; min-height: 36px; font-family: var(--f-sello); font-size: 15px; }
  ul a:hover { color: var(--verde); text-decoration: underline; }
  .marca-conjunto { width: 14px; height: 14px; background: var(--stock); flex: 0 0 auto; }
  .foot-bottom {
    display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    padding-top: 20px; border-top: 2px solid #3B3B38;
    font-size: 13px; color: #D9D6CA;
  }
  .firma-jc { display: flex; gap: 14px; flex-wrap: wrap; align-items: baseline; color: var(--papel); }
  .cotiza { color: var(--verde); text-decoration: underline; }
  @media (max-width: 600px) { .foot-bottom { padding-right: 76px; } }
</style>
