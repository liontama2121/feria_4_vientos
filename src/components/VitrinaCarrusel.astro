---
// Vitrina de la feria: título con la fecha de la próxima feria y TODOS los emprendimientos que
// están en la feria, uno a uno (una diapositiva por emprendimiento) con su descripción.
// Mezcla los 4 conjuntos intercalados. Autoplay 7 s, pausa al pasar el mouse o con foco,
// botones circulares y dots del color del conjunto activo.
import { ICONOS, categoria, enlacesRedes } from '../lib/constantes';
import type { EmprendedorPublico, Fecha, Torre } from '../lib/db';
import { fechaLarga, rangoHoras } from '../lib/fechas';

interface Props {
  emprendedores: EmprendedorPublico[];
  torres: Torre[];
  proxima?: Fecha;
}
const { emprendedores, torres, proxima } = Astro.props;
const torreDe = (id: string) => torres.find((t) => t.id === id) ?? torres[0];

// Intercala torres para que el carrusel alterne colores (Austro, Mistral, Gregal, Cierzo, …).
const porTorre = torres.map((t) => emprendedores.filter((e) => e.torre === t.id));
const slides: EmprendedorPublico[] = [];
for (let i = 0; porTorre.some((l) => l[i]); i++) porTorre.forEach((l) => l[i] && slides.push(l[i]));
---

{
  slides.length > 0 && (
    <section class="vitrina-section" aria-roledescription="carrusel" aria-label="Vitrina de emprendimientos">
      <div class="wrap">
        <div class="vitrina-head">
          {proxima ? (
            <>
              <span class="kicker">
                La próxima feria · {rangoHoras(proxima)} · El terminalito
              </span>
              <h2>
                <span class="serif grad-text">Feria</span> · {fechaLarga(proxima.fecha)}
              </h2>
              <p class="vitrina-sub">
                {`${slides.length} ${slides.length === 1 ? 'emprendimiento te espera' : 'emprendimientos te esperan'}. Conócelos uno a uno.`}
              </p>
            </>
          ) : (
            <>
              <span class="kicker">La feria · pronto vendrán más fechas</span>
              <h2>
                Lo que trae <span class="serif grad-text">cada viento</span>.
              </h2>
            </>
          )}
        </div>
      </div>

      <div class="wrap vitrina-wrap" data-vitrina>
        <button class="vitrina-btn prev" type="button" data-prev aria-label="Anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button class="vitrina-btn next" type="button" data-next aria-label="Siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>

        <div class="vitrina-track" data-track>
          {slides.map((e, i) => {
            const t = torreDe(e.torre);
            const cat = categoria(e.categoria);
            const redes = enlacesRedes(e);
            return (
              <article
                class="vitrina-slide"
                style={`--t:${t.color_hex};--t-claro:${t.color_claro}`}
                data-color={t.color_hex}
                aria-roledescription="diapositiva"
                aria-label={`${i + 1} de ${slides.length}: ${e.nombre_emprendimiento}`}
              >
                <div class="vitrina-img">
                  <span class="vitrina-tag">
                    <span class="dot" /> {t.nombre.toUpperCase()}
                  </span>
                  {e.foto_principal ? (
                    <img src={e.foto_principal} alt={`Foto de ${e.nombre_emprendimiento}`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="emoji" aria-hidden="true">
                      {e.emoji_placeholder || cat.emoji}
                    </span>
                  )}
                </div>
                <div class="vitrina-info">
                  <span class="num">
                    {String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}
                  </span>
                  <span class="cat">
                    {cat.emoji} {cat.label}
                  </span>
                  <h3>{e.nombre_emprendimiento}</h3>
                  <div class="by">
                    {`${e.nombre_vecino} · ${t.nombre}${e.apartamento ? ` · Apto ${e.apartamento}` : ''}`}
                  </div>
                  <p class="corta">{e.descripcion_corta}</p>
                  {e.descripcion_larga && <p class="larga">{e.descripcion_larga}</p>}
                  <div class="vitrina-foot">
                    <div class="socials">
                      {redes.map((r) => (
                        <a href={r.url} target="_blank" rel="noopener" aria-label={`${r.label} de ${e.nombre_emprendimiento}`}>
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d={ICONOS[r.red]} />
                          </svg>
                        </a>
                      ))}
                    </div>
                    <button type="button" class="vitrina-mas" data-detalle={e.slug}>
                      Ver fotos y contacto →
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="vitrina-dots" data-dots />
      </div>
    </section>
  )
}

<script>
  // 7 s: cada diapositiva trae descripción completa y hay que alcanzar a leerla.
  const AUTOPLAY_MS = 7000;

  document.querySelectorAll<HTMLElement>('[data-vitrina]').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('[data-track]')!;
    const dotsWrap = wrap.querySelector<HTMLElement>('[data-dots]')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.vitrina-slide'));
    const total = slides.length;
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    let timer: number | undefined;

    const dots = slides.map((slide, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'vitrina-dot';
      dot.setAttribute('aria-label', `Ir al emprendimiento ${i + 1}`);
      dot.style.setProperty('--c', slide.dataset.color ?? '#1A1633');
      dot.addEventListener('click', () => {
        detener();
        ir(i);
      });
      dotsWrap.appendChild(dot);
      return dot;
    });

    function pintarDots(i: number) {
      dots.forEach((d, j) => {
        d.classList.toggle('activo', j === i);
        d.setAttribute('aria-current', String(j === i));
      });
    }

    function ir(i: number) {
      actual = (i + total) % total;
      const s = slides[actual];
      track.scrollTo({ left: s.offsetLeft - track.clientWidth / 2 + s.clientWidth / 2, behavior: reducido ? 'auto' : 'smooth' });
      pintarDots(actual);
    }

    // Scroll manual (dedo o trackpad): el dot sigue al slide más centrado.
    let t: number | undefined;
    track.addEventListener('scroll', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const centro = track.scrollLeft + track.clientWidth / 2;
        let cercano = 0;
        let min = Infinity;
        slides.forEach((s, i) => {
          const d = Math.abs(centro - (s.offsetLeft + s.clientWidth / 2));
          if (d < min) {
            min = d;
            cercano = i;
          }
        });
        actual = cercano;
        pintarDots(actual);
      }, 100);
    });

    function iniciar() {
      if (reducido || timer) return;
      timer = window.setInterval(() => ir(actual + 1), AUTOPLAY_MS);
    }
    function detener() {
      clearInterval(timer);
      timer = undefined;
    }

    wrap.querySelector('[data-prev]')!.addEventListener('click', () => { detener(); ir(actual - 1); });
    wrap.querySelector('[data-next]')!.addEventListener('click', () => { detener(); ir(actual + 1); });
    wrap.addEventListener('mouseenter', detener);
    wrap.addEventListener('mouseleave', iniciar);
    wrap.addEventListener('focusin', detener);
    document.addEventListener('visibilitychange', () => (document.hidden ? detener() : iniciar()));

    pintarDots(0);
    iniciar();
  });
</script>

<style>
  .vitrina-section { position: relative; overflow: hidden; padding: 90px 0; background: #fff; }
  .vitrina-section::before {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 1200px; height: 400px; border-radius: 50%;
    background:
      radial-gradient(circle at 20% 50%, var(--mistral-medio) 0%, transparent 40%),
      radial-gradient(circle at 45% 50%, var(--gregal-medio) 0%, transparent 40%),
      radial-gradient(circle at 65% 50%, var(--austro-medio) 0%, transparent 40%),
      radial-gradient(circle at 85% 50%, var(--cierzo-medio) 0%, transparent 40%);
    filter: blur(80px); opacity: .4;
    pointer-events: none;
  }
  .vitrina-head { text-align: center; margin-bottom: 36px; }
  .vitrina-head h2 { font-size: clamp(32px, 4.6vw, 56px); letter-spacing: -.035em; }
  .vitrina-sub { margin-top: 10px; color: var(--tinta-media); font-size: 16px; }

  .vitrina-wrap { position: relative; }
  .vitrina-track {
    display: flex; gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 20px 24px 30px; margin: 0 -24px;
    scrollbar-width: none;
  }
  .vitrina-track::-webkit-scrollbar { display: none; }

  /* Una diapositiva por vista: el emprendimiento completo, uno a uno. */
  .vitrina-slide {
    flex: 0 0 100%; scroll-snap-align: center;
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    border-radius: var(--radio); overflow: hidden; background: #fff;
    border-top: 6px solid var(--t);
    box-shadow: 0 12px 36px rgba(26, 22, 51, .08);
  }
  @media (max-width: 760px) { .vitrina-slide { grid-template-columns: 1fr; } }

  .vitrina-img {
    position: relative; min-height: 420px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(160deg, color-mix(in srgb, var(--t) 45%, var(--t-claro)), var(--t-claro) 60%, #fff);
  }
  .vitrina-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vitrina-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(26, 22, 51, .22) 100%); pointer-events: none; }
  .emoji { font-size: 130px; }
  @media (max-width: 760px) { .vitrina-img { min-height: 0; aspect-ratio: 4 / 3; } .emoji { font-size: 100px; } }

  .vitrina-tag {
    position: absolute; top: 16px; left: 16px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 999px;
    background: rgba(255, 255, 255, .95);
    font-family: var(--display); font-size: 11px; font-weight: 800; letter-spacing: .08em;
    color: var(--t);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
  }
  .vitrina-tag .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--t); }

  .vitrina-info { padding: 36px 40px; display: flex; flex-direction: column; min-width: 0; }
  @media (max-width: 760px) { .vitrina-info { padding: 24px 22px 26px; } }
  .num { font-family: var(--display); font-size: 12px; font-weight: 800; letter-spacing: .12em; color: var(--t); margin-bottom: 14px; }
  .cat { font-family: var(--display); font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--tinta-suave); margin-bottom: 8px; }
  .vitrina-info h3 { font-size: clamp(26px, 3vw, 36px); letter-spacing: -.025em; margin-bottom: 4px; overflow-wrap: anywhere; }
  .by { font-size: 13.5px; font-weight: 600; color: var(--tinta-suave); margin-bottom: 18px; }
  .corta { font-size: 17px; font-weight: 600; color: var(--tinta); line-height: 1.45; margin-bottom: 12px; }
  .larga {
    font-size: 15px; color: var(--tinta-media); line-height: 1.6; white-space: pre-line;
    display: -webkit-box; -webkit-line-clamp: 7; -webkit-box-orient: vertical; overflow: hidden;
  }
  .vitrina-foot { margin-top: auto; padding-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .socials { display: flex; gap: 6px; }
  .socials a {
    width: 36px; height: 36px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--t-claro); color: var(--t);
  }
  .socials svg { width: 16px; height: 16px; }
  .vitrina-mas {
    font-family: var(--display); font-weight: 700; font-size: 14px;
    padding: 11px 18px; border-radius: 999px; border: none;
    background: var(--t); color: #fff;
  }

  .vitrina-btn {
    position: absolute; top: 45%; transform: translateY(-50%); z-index: 3;
    width: 52px; height: 52px; border-radius: 50%;
    background: #fff; border: 1px solid var(--linea); color: var(--tinta);
    box-shadow: 0 8px 24px rgba(26, 22, 51, .15);
    display: flex; align-items: center; justify-content: center;
    transition: transform .15s ease, background .15s ease;
  }
  .vitrina-btn:hover { transform: translateY(-50%) scale(1.08); background: var(--crema); }
  .vitrina-btn svg { width: 20px; height: 20px; }
  .vitrina-btn.prev { left: -26px; }
  .vitrina-btn.next { right: -26px; }
  @media (max-width: 1240px) { .vitrina-btn.prev { left: 6px; } .vitrina-btn.next { right: 6px; } }
  @media (max-width: 760px) { .vitrina-btn { top: 22%; width: 44px; height: 44px; } }

  .vitrina-dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
  .vitrina-dots :global(.vitrina-dot) {
    width: 8px; height: 8px; border-radius: 999px; border: none; padding: 0;
    background: rgba(26, 22, 51, .15);
    transition: background .2s ease, width .2s ease;
  }
  .vitrina-dots :global(.vitrina-dot.activo) { width: 28px; background: var(--c); }
</style>
