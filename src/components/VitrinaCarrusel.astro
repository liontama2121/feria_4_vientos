---
// Vitrina de la feria (solo con feria activa): la fecha en grande y TODOS los que están en la
// feria, uno a uno, cada uno como un afiche de la cartulina de su conjunto. Mezcla los 4
// conjuntos intercalados. Autoplay 7 s, pausa al pasar el mouse o con foco.
import { ICONOS, categoria, enlacesRedes, iniciales } from '../lib/constantes';
import type { EmprendedorPublico, Fecha, Torre } from '../lib/db';
import { fechaLarga, rangoHoras } from '../lib/fechas';

interface Props {
  emprendedores: EmprendedorPublico[];
  torres: Torre[];
  proxima?: Fecha;
}
const { emprendedores, torres, proxima } = Astro.props;
const torreDe = (id: string) => torres.find((t) => t.id === id) ?? torres[0];
// Color del punto del carrusel = la cartulina del conjunto (ver muro.css)
const STOCK_HEX: Record<string, string> = { mistral: '#B7E8D6', gregal: '#FF5A1F', austro: '#FF3CA7', cierzo: '#D2C4FF' };

// Intercala conjuntos para que el carrusel alterne cartulinas.
const porTorre = torres.map((t) => emprendedores.filter((e) => e.torre === t.id));
const slides: EmprendedorPublico[] = [];
for (let i = 0; porTorre.some((l) => l[i]); i++) porTorre.forEach((l) => l[i] && slides.push(l[i]));
---

{
  slides.length > 0 && (
    <section class="vitrina" aria-roledescription="carrusel" aria-label="Vitrina de la feria">
      <div class="wrap">
        <h2 class="vitrina-titulo">{proxima ? `Feria · ${fechaLarga(proxima.fecha)}` : 'Lo que trae cada viento'}</h2>
        {proxima && (
          <p class="sello vitrina-sub">
            {rangoHoras(proxima)} · El terminalito · {`${slides.length} ${slides.length === 1 ? 'emprendimiento te espera' : 'emprendimientos te esperan'}`}
          </p>
        )}
      </div>

      <div class="wrap vitrina-wrap" data-vitrina>
        <button class="vitrina-btn prev boton" type="button" data-prev aria-label="Anterior">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button class="vitrina-btn next boton" type="button" data-next aria-label="Siguiente">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>

        <div class="vitrina-track" data-track>
          {slides.map((e, i) => {
            const t = torreDe(e.torre);
            const cat = categoria(e.categoria, Astro.locals.categorias);
            const redes = enlacesRedes(e);
            return (
              <article
                class="vitrina-slide"
                data-conjunto={t.id}
                data-color={STOCK_HEX[t.id] ?? '#111111'}
                aria-roledescription="diapositiva"
                aria-label={`${i + 1} de ${slides.length}: ${e.nombre_emprendimiento}`}
              >
                <div class="vitrina-img">
                  {e.foto_principal ? (
                    <img src={e.foto_principal} alt={`Foto de ${e.nombre_emprendimiento}`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="iniciales" aria-hidden="true">
                      {iniciales(e.nombre_emprendimiento || e.nombre_vecino)}
                    </span>
                  )}
                </div>
                <div class="vitrina-info">
                  <p class="sello chip">{t.nombre} · {cat.label}</p>
                  <h3>{e.nombre_emprendimiento}</h3>
                  <p class="sello by">{`${e.nombre_vecino}${e.apartamento ? ` · ${e.apartamento}` : ''}`}</p>
                  <p class="corta">{e.descripcion_corta}</p>
                  {e.descripcion_larga && <p class="larga">{e.descripcion_larga}</p>}
                  <div class="vitrina-foot">
                    <div class="socials">
                      {redes.map((r) => (
                        <a href={r.url} target="_blank" rel="noopener" aria-label={`${r.label} de ${e.nombre_emprendimiento}`}>
                          <svg viewBox="0 0 24 24" class="ico ico-lleno" aria-hidden="true">
                            <path d={ICONOS[r.red]} />
                          </svg>
                        </a>
                      ))}
                    </div>
                    <button type="button" class="boton boton-tinta" data-detalle={e.slug}>
                      Ver fotos y contacto
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="vitrina-dots" data-dots />
      </div>
    </section>
  )
}

<script>
  // 7 s: cada diapositiva trae descripción completa y hay que alcanzar a leerla.
  const AUTOPLAY_MS = 7000;

  document.querySelectorAll<HTMLElement>('[data-vitrina]').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('[data-track]')!;
    const dotsWrap = wrap.querySelector<HTMLElement>('[data-dots]')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.vitrina-slide'));
    const total = slides.length;
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    let timer: number | undefined;

    const dots = slides.map((slide, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'vitrina-dot';
      dot.setAttribute('aria-label', `Ir al emprendimiento ${i + 1}`);
      dot.style.setProperty('--c', slide.dataset.color ?? '#111111');
      dot.addEventListener('click', () => {
        detener();
        ir(i);
      });
      dotsWrap.appendChild(dot);
      return dot;
    });

    function pintarDots(i: number) {
      dots.forEach((d, j) => {
        d.classList.toggle('activo', j === i);
        d.setAttribute('aria-current', String(j === i));
      });
    }

    function ir(i: number) {
      actual = (i + total) % total;
      const s = slides[actual];
      track.scrollTo({ left: s.offsetLeft - track.clientWidth / 2 + s.clientWidth / 2, behavior: reducido ? 'auto' : 'smooth' });
      pintarDots(actual);
    }

    // Scroll manual (dedo o trackpad): el dot sigue al slide más centrado.
    let t: number | undefined;
    track.addEventListener('scroll', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const centro = track.scrollLeft + track.clientWidth / 2;
        let cercano = 0;
        let min = Infinity;
        slides.forEach((s, i) => {
          const d = Math.abs(centro - (s.offsetLeft + s.clientWidth / 2));
          if (d < min) {
            min = d;
            cercano = i;
          }
        });
        actual = cercano;
        pintarDots(actual);
      }, 100);
    });

    function iniciar() {
      if (reducido || timer) return;
      timer = window.setInterval(() => ir(actual + 1), AUTOPLAY_MS);
    }
    function detener() {
      clearInterval(timer);
      timer = undefined;
    }

    wrap.querySelector('[data-prev]')!.addEventListener('click', () => { detener(); ir(actual - 1); });
    wrap.querySelector('[data-next]')!.addEventListener('click', () => { detener(); ir(actual + 1); });
    wrap.addEventListener('mouseenter', detener);
    wrap.addEventListener('mouseleave', iniciar);
    wrap.addEventListener('focusin', detener);
    document.addEventListener('visibilitychange', () => (document.hidden ? detener() : iniciar()));

    pintarDots(0);
    iniciar();
  });
</script>

<style>
  .vitrina { padding: 40px 0 90px; }
  .vitrina-titulo { font-size: clamp(52px, 7.4vw, 112px); margin-bottom: 10px; }
  .vitrina-sub { font-size: 15px; margin-bottom: 28px; }

  .vitrina-wrap { position: relative; }
  .vitrina-track {
    display: flex; gap: 24px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 20px 24px 36px; margin: 0 -24px;
    scrollbar-width: none;
  }
  .vitrina-track::-webkit-scrollbar { display: none; }

  /* Un afiche por vista */
  .vitrina-slide {
    flex: 0 0 100%; scroll-snap-align: center;
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    background: var(--stock, var(--papel)); color: var(--xerox);
    box-shadow: var(--sombra-papel-alta);
  }
  @media (max-width: 760px) { .vitrina-slide { grid-template-columns: 1fr; } }

  .vitrina-img { position: relative; min-height: 440px; display: flex; align-items: center; justify-content: center; background: var(--xerox); }
  .vitrina-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .iniciales { font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 180px; line-height: .8; color: var(--stock); }
  @media (max-width: 760px) { .vitrina-img { min-height: 0; aspect-ratio: 4 / 3; } .iniciales { font-size: 120px; } }

  .vitrina-info { padding: 40px 40px 34px; display: flex; flex-direction: column; min-width: 0; }
  @media (max-width: 760px) { .vitrina-info { padding: 26px 20px 26px; } }
  .chip { align-self: flex-start; background: var(--xerox); color: var(--stock, var(--papel)); padding: 6px 12px 4px; font-size: 13px; transform: rotate(-2deg); margin-bottom: 14px; }
  .vitrina-info h3 { font-size: clamp(48px, 5.4vw, 80px); margin-bottom: 8px; overflow-wrap: anywhere; }
  .by { font-size: 14px; margin-bottom: 18px; }
  .corta { font-size: 19px; font-weight: 600; line-height: 1.4; margin-bottom: 12px; }
  .larga {
    font-size: 16px; line-height: 1.55; white-space: pre-line;
    display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden;
  }
  .vitrina-foot { margin-top: auto; padding-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .socials { display: flex; gap: 4px; }
  .socials a { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  .socials a:hover { background: var(--xerox); color: var(--stock, var(--papel)); }
  .socials .ico { width: 20px; height: 20px; }

  .vitrina-btn { position: absolute; top: 45%; transform: translateY(-50%); z-index: 3; width: 56px; padding: 0; }
  .vitrina-btn:hover { transform: translateY(-50%) rotate(-3deg); }
  .vitrina-btn .ico { width: 24px; height: 24px; stroke-width: 2.6; }
  .vitrina-btn.prev { left: -20px; }
  .vitrina-btn.next { right: -20px; }
  @media (max-width: 1360px) { .vitrina-btn.prev { left: 6px; } .vitrina-btn.next { right: 6px; } }
  @media (max-width: 760px) { .vitrina-btn { top: 22%; } }

  .vitrina-dots { display: flex; justify-content: center; gap: 8px; margin-top: 10px; }
  .vitrina-dots :global(.vitrina-dot) { width: 16px; height: 16px; border: 2px solid var(--xerox); padding: 0; background: transparent; transition: background .2s ease, transform .25s var(--ease); }
  .vitrina-dots :global(.vitrina-dot.activo) { background: var(--c); transform: rotate(45deg) scale(1.15); }
</style>
