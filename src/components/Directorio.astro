---
// Directorio = el muro: TODOS los emprendimientos aprobados, estén o no en la feria.
// Las tiras rasgadas filtran por categoría; el buscador vive en la hoja verde del Hero
// (#dirBuscar). El filtro corre en el navegador sobre los avisos ya renderizados.
import EmprendedorCard from './EmprendedorCard.astro';
import { LIMITES, categoria } from '../lib/constantes';
import type { EmprendedorPublico, Torre } from '../lib/db';

interface Props {
  emprendedores: EmprendedorPublico[];
  torres: Torre[];
}
const { emprendedores, torres } = Astro.props;
const torreDe = (id: string) => torres.find((t) => t.id === id) ?? torres[0];

const normalizar = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase();

// Los nuevos primero (el más reciente arriba) para darles una oportunidad; el resto en orden alfabético.
const lista = [...emprendedores].sort(
  (a, b) =>
    Number(!!b.nuevo) - Number(!!a.nuevo) ||
    (a.nuevo && b.nuevo ? (b.publicado_desde ?? '').localeCompare(a.publicado_desde ?? '') : 0) ||
    a.nombre_emprendimiento.localeCompare(b.nombre_emprendimiento, 'es'),
);
// "Lo mejor calificado": con un mínimo de votos para que un solo 5★ no gane.
const mejores = lista
  .filter((e) => (e.calificacion?.total ?? 0) >= LIMITES.minVotosTop)
  .sort((a, b) => b.calificacion!.promedio - a.calificacion!.promedio || b.calificacion!.total - a.calificacion!.total)
  .slice(0, LIMITES.top);
// Si TODOS son nuevos (o todos entran al top), la franja repetiría el muro entero: no se muestra.
const nuevos = lista.filter((e) => e.nuevo);
if (nuevos.length >= lista.length) nuevos.length = 0;
if (mejores.length >= lista.length) mejores.length = 0;
// Tiras por la categoría que se VE (un id desconocido cuenta como "Otros"), solo las que tienen emprendimientos.
const catDe = (id: string) => categoria(id, Astro.locals.categorias);
const categorias = Astro.locals.categorias
  .map((c) => ({ ...c, n: lista.filter((e) => catDe(e.categoria).id === c.id).length }))
  .filter((c) => c.n > 0);
const hayFeria = lista.some((e) => e.en_feria);
// Cartulinas descoloridas por el sol para las tiras (capas viejas del muro)
const STOCKS = ['var(--lila)', 'var(--menta)', 'var(--rosa)', 'var(--naranja)'];
---

<section class="directorio" id="directorio" aria-labelledby="dir-titulo">
  <div class="wrap">
    <div class="tiras" role="group" aria-label="Filtrar por categoría">
      <button type="button" class="tira tira-todas pegar" data-cat="" aria-pressed="true" style="--i:2">
        <span class="tira-nombre">Todas</span>
        <span class="sello tira-n">{lista.length}</span>
      </button>
      {
        categorias.map((c, i) => (
          <button type="button" class="tira pegar" data-cat={c.id} aria-pressed="false" style={`--i:${i + 3};--stock:${STOCKS[i % STOCKS.length]};--desfase:${(i % 3) * 3}%`}>
            <span class="tira-nombre">{c.label}</span>
            <span class="sello tira-n">{c.n}</span>
            <svg class="ico tira-mas" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"></path></svg>
          </button>
        ))
      }
    </div>

    {
      lista.length > 0 && (
        <>
          {(mejores.length > 0 || nuevos.length > 0) && (
            <div class="resaltados" id="dirResaltados">
              {mejores.length > 0 && (
                <div class="franja">
                  <h2 class="franja-titulo franja-negra">Lo mejor calificado</h2>
                  <p class="sello franja-bajada">Lo que más recomiendan los vecinos.</p>
                  <div class="muro-grid">
                    {mejores.map((e) => (
                      <div class="dir-item">
                        <EmprendedorCard e={e} torre={torreDe(e.torre)} enFeria={e.en_feria} />
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {nuevos.length > 0 && (
                <div class="franja">
                  <h2 class="franja-titulo franja-verde">Recién pegados</h2>
                  <p class="sello franja-bajada">Vecinos que acaban de abrir su emprendimiento. Dales una oportunidad.</p>
                  <div class="muro-grid">
                    {nuevos.map((e) => (
                      <div class="dir-item">
                        <EmprendedorCard e={e} torre={torreDe(e.torre)} enFeria={e.en_feria} />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          <div class="muro-head" id="muro">
            <h2 id="dir-titulo">Todo el muro</h2>
            <p class="sello dir-conteo" id="dirConteo" aria-live="polite">
              {`${lista.length} ${lista.length === 1 ? 'emprendimiento' : 'emprendimientos'}`}
            </p>
            {hayFeria && (
              <button type="button" class="boton sello-feria" id="dirSoloFeria" aria-pressed="false">
                Solo los de la feria
              </button>
            )}
          </div>

          <div class="muro-grid dir-grid-todos">
            {lista.map((e) => {
              const t = torreDe(e.torre);
              const cat = catDe(e.categoria);
              const texto = normalizar(
                [e.nombre_emprendimiento, e.nombre_vecino, e.descripcion_corta, e.descripcion_larga, cat.label, t.nombre, e.instagram].join(' '),
              );
              return (
                <div class="dir-item" data-cat={cat.id} data-feria={e.en_feria ? '1' : '0'} data-texto={texto}>
                  <EmprendedorCard e={e} torre={t} enFeria={e.en_feria} />
                </div>
              );
            })}
          </div>

          <div class="vacio con-sombra" id="dirVacio" hidden>
            <div class="hoja rasgado-ambos">
              <p class="vacio-titulo">No hay avisos con eso</p>
              <p>Prueba con otra palabra o toca “Todas”.</p>
            </div>
          </div>
        </>
      )
    }

    {
      lista.length === 0 && (
        <div class="vacio con-sombra">
          <div class="hoja rasgado-ambos">
            <p class="vacio-titulo">El muro está esperando su primer aviso</p>
            <p>
              ¿Tienes un emprendimiento? <a href="#participar">Pega el tuyo</a>.
            </p>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  const seccion = document.getElementById('directorio');
  if (seccion) {
    const buscar = document.getElementById('dirBuscar') as HTMLInputElement | null;
    const soloFeria = document.getElementById('dirSoloFeria');
    const tiras = Array.from(seccion.querySelectorAll<HTMLButtonElement>('.tira[data-cat]'));
    const items = Array.from(seccion.querySelectorAll<HTMLElement>('.dir-grid-todos .dir-item'));
    const resaltados = document.getElementById('dirResaltados');
    const conteo = document.getElementById('dirConteo');
    const vacio = document.getElementById('dirVacio');
    let categoria = '';
    const normalizar = (s: string) =>
      s
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase()
        .trim();

    function filtrar() {
      const palabras = normalizar(buscar?.value ?? '').split(/\s+/).filter(Boolean);
      const feria = soloFeria?.getAttribute('aria-pressed') === 'true';
      let n = 0;
      for (const it of items) {
        const ok =
          (!categoria || it.dataset.cat === categoria) &&
          (!feria || it.dataset.feria === '1') &&
          palabras.every((p) => it.dataset.texto!.includes(p));
        it.hidden = !ok;
        if (ok) n++;
      }
      if (conteo) conteo.textContent = `${n} ${n === 1 ? 'emprendimiento' : 'emprendimientos'}`;
      if (vacio) vacio.hidden = n > 0;
      // Al buscar o filtrar, las franjas estorban: solo se ve el resultado.
      if (resaltados) resaltados.hidden = !!(palabras.length || categoria || feria);
    }

    buscar?.addEventListener('input', filtrar);
    tiras.forEach((t) =>
      t.addEventListener('click', () => {
        categoria = t.dataset.cat ?? '';
        tiras.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
        filtrar();
        if (categoria) document.getElementById('muro')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }),
    );
    soloFeria?.addEventListener('click', () => {
      soloFeria.setAttribute('aria-pressed', String(soloFeria.getAttribute('aria-pressed') !== 'true'));
      filtrar();
    });
  }
</script>

<style>
  .directorio { padding: 8px 0 110px; scroll-margin-top: 64px; }

  /* Tiras rasgadas superpuestas: capas viejas del muro. La elegida se despega. */
  .tiras { display: flex; flex-direction: column; margin: 0 0 64px; }
  /* Escritorio: dos columnas de tiras, para que los avisos lleguen antes */
  @media (min-width: 1000px) {
    .tiras { display: grid; grid-template-columns: 1fr 1fr; column-gap: 26px; }
    .tira-todas { grid-column: 1 / -1; }
  }
  .tira {
    --borde-alto: 12px;
    position: relative;
    display: flex; align-items: center; gap: 18px;
    width: calc(100% - var(--desfase, 0%)); margin-left: var(--desfase, 0%);
    margin-top: -10px; min-height: 76px; padding: 18px 28px 14px;
    background: var(--stock, var(--papel)); color: var(--xerox);
    border: 0; text-align: left; cursor: pointer;
    -webkit-mask: url('/muro/borde-arriba.svg') top left / 400px 12px repeat-x, url('/muro/borde-abajo.svg') bottom 0 left 211px / 400px 12px repeat-x, linear-gradient(#000 0 0) center / 100% calc(100% - 22px) no-repeat;
    mask: url('/muro/borde-arriba.svg') top left / 400px 12px repeat-x, url('/muro/borde-abajo.svg') bottom 0 left 211px / 400px 12px repeat-x, linear-gradient(#000 0 0) center / 100% calc(100% - 22px) no-repeat;
    transition: transform .45s var(--ease), background .2s ease, color .2s ease;
  }
  .tira:nth-child(odd) { transform: rotate(-.5deg); }
  .tira:nth-child(even) { transform: rotate(.4deg); }
  .tira:hover { transform: translateX(10px) rotate(-.8deg); }
  .tira[aria-pressed='true'] { background: var(--xerox); color: var(--verde); transform: translateX(18px) rotate(-1.4deg); z-index: 2; }
  .tira-todas { --stock: var(--papel); }
  .tira-nombre {
    flex: 1; min-width: 0;
    font-family: var(--f-display); font-stretch: 62%; font-weight: 900; text-transform: uppercase;
    font-size: clamp(34px, 4.2vw, 58px); line-height: .9;
    overflow-wrap: anywhere;
  }
  .tira-n { font-size: 20px; font-variant-numeric: tabular-nums; }
  .tira-mas { width: 30px; height: 30px; stroke-width: 2.6; transition: transform .35s var(--ease); }
  .tira[aria-pressed='true'] .tira-mas { transform: rotate(45deg); }
  @media (max-width: 600px) { .tira { padding: 16px 16px 12px; min-height: 64px; gap: 12px; } .tira-n { font-size: 17px; } }

  .franja { margin-bottom: 72px; }
  .franja-titulo {
    display: inline-block; font-size: clamp(44px, 6vw, 84px);
    padding: 14px 22px 8px; margin-bottom: 10px;
    transform: rotate(-1.2deg);
  }
  .franja-negra { background: var(--xerox); color: var(--verde); }
  .franja-verde { background: var(--verde); color: var(--xerox); transform: rotate(1deg); }
  .franja-bajada { font-size: 15px; margin-bottom: 26px; }
  .resaltados[hidden] { display: none; }

  .muro-head { display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; scroll-margin-top: 84px; }
  .muro-head h2 { font-size: clamp(56px, 8vw, 116px); }
  .dir-conteo { font-size: 16px; }
  .sello-feria { margin-left: auto; }
  .sello-feria[aria-pressed='true'] { background: var(--rosa); }

  .muro-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 38px 28px; align-items: start; }
  @media (max-width: 700px) { .muro-grid { grid-template-columns: 1fr; gap: 30px; } }
  .dir-item[hidden] { display: none; }
  /* Pegados a mano: ningún aviso queda derecho */
  .dir-item:nth-child(4n + 1) { --r: -1.4deg; }
  .dir-item:nth-child(4n + 2) { --r: .9deg; margin-top: 14px; }
  .dir-item:nth-child(4n + 3) { --r: -.6deg; margin-top: 6px; }
  .dir-item:nth-child(4n + 4) { --r: 1.6deg; }
  @media (max-width: 700px) { .dir-item:nth-child(n) { margin-top: 0; } }

  .vacio { max-width: 620px; margin: 20px auto 0; }
  .vacio .hoja { --stock: var(--papel); padding: 40px 32px; text-align: center; transform: rotate(-1deg); }
  .vacio-titulo { font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 44px; text-transform: uppercase; line-height: .9; margin-bottom: 10px; }
  .vacio a { text-decoration: underline; font-weight: 700; }
  .vacio[hidden] { display: none; }
</style>
