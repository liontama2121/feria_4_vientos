---
// Directorio = los puestos de la plaza: TODOS los aprobados, estén o no en la feria.
// El buscador (#dirBuscar) y las etiquetas de categoría viven en el letrero del Hero.
// El filtro corre en el navegador sobre los puestos ya renderizados.
import EmprendedorCard from './EmprendedorCard.astro';
import { LIMITES, categoria } from '../lib/constantes';
import type { EmprendedorPublico, Torre } from '../lib/db';

interface Props {
  emprendedores: EmprendedorPublico[];
  torres: Torre[];
}
const { emprendedores, torres } = Astro.props;
const torreDe = (id: string) => torres.find((t) => t.id === id) ?? torres[0];

const normalizar = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase();

// Los nuevos primero (el más reciente arriba) para darles una oportunidad; el resto en orden alfabético.
const lista = [...emprendedores].sort(
  (a, b) =>
    Number(!!b.nuevo) - Number(!!a.nuevo) ||
    (a.nuevo && b.nuevo ? (b.publicado_desde ?? '').localeCompare(a.publicado_desde ?? '') : 0) ||
    a.nombre_emprendimiento.localeCompare(b.nombre_emprendimiento, 'es'),
);
// "Lo mejor calificado": con un mínimo de votos para que un solo 5★ no gane.
const mejores = lista
  .filter((e) => (e.calificacion?.total ?? 0) >= LIMITES.minVotosTop)
  .sort((a, b) => b.calificacion!.promedio - a.calificacion!.promedio || b.calificacion!.total - a.calificacion!.total)
  .slice(0, LIMITES.top);
// Si TODOS son nuevos (o todos entran al top), la franja repetiría la lista entera: no se muestra.
const nuevos = lista.filter((e) => e.nuevo);
if (nuevos.length >= lista.length) nuevos.length = 0;
if (mejores.length >= lista.length) mejores.length = 0;
const catDe = (id: string) => categoria(id, Astro.locals.categorias);
---

<section class="directorio" id="directorio" aria-labelledby="dir-titulo">
  <div class="wrap">
    {
      lista.length > 0 && (
        <>
          {(mejores.length > 0 || nuevos.length > 0) && (
            <div class="resaltados" id="dirResaltados">
              {mejores.length > 0 && (
                <div class="franja">
                  <h2 class="franja-titulo">Los favoritos del barrio</h2>
                  <p class="franja-bajada">Lo que mejor califican los vecinos.</p>
                  <div class="lista">
                    {mejores.map((e) => (
                      <EmprendedorCard e={e} torre={torreDe(e.torre)} enFeria={e.en_feria} />
                    ))}
                  </div>
                </div>
              )}
              {nuevos.length > 0 && (
                <div class="franja">
                  <h2 class="franja-titulo">Recién llegados</h2>
                  <p class="franja-bajada">Vecinos que acaban de abrir su emprendimiento. Dales una oportunidad.</p>
                  <div class="lista">
                    {nuevos.map((e) => (
                      <EmprendedorCard e={e} torre={torreDe(e.torre)} enFeria={e.en_feria} />
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          <div class="dir-head" id="muro">
            <h2 id="dir-titulo">Todos los puestos</h2>
            <p class="dir-conteo etiqueta" id="dirConteo" aria-live="polite">
              {`${lista.length} ${lista.length === 1 ? 'emprendimiento' : 'emprendimientos'}`}
            </p>
          </div>

          <div class="lista dir-grid-todos">
            {lista.map((e) => {
              const t = torreDe(e.torre);
              const cat = catDe(e.categoria);
              const texto = normalizar(
                [e.nombre_emprendimiento, e.nombre_vecino, e.descripcion_corta, e.descripcion_larga, cat.label, t.nombre, e.instagram].join(' '),
              );
              return (
                <div class="dir-item" data-cat={cat.id} data-feria={e.en_feria ? '1' : '0'} data-texto={texto}>
                  <EmprendedorCard e={e} torre={t} enFeria={e.en_feria} />
                </div>
              );
            })}
          </div>

          <div class="vacio letrero" id="dirVacio" hidden>
            <p class="vacio-titulo">No encontramos eso</p>
            <p>Pruebe con otra palabra o toque “Todo” en las etiquetas.</p>
          </div>
        </>
      )
    }

    {
      lista.length === 0 && (
        <div class="vacio letrero">
          <p class="vacio-titulo">La plaza está esperando su primer puesto</p>
          <p>
            ¿Tiene un emprendimiento? <a href="#participar">Ponga su puesto</a>.
          </p>
        </div>
      )
    }
  </div>
</section>

<script>
  const seccion = document.getElementById('directorio');
  if (seccion) {
    const buscar = document.getElementById('dirBuscar') as HTMLInputElement | null;
    const soloFeria = document.getElementById('dirSoloFeria');
    const teclas = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-filtro-cat]'));
    const items = Array.from(seccion.querySelectorAll<HTMLElement>('.dir-grid-todos .dir-item'));
    const resaltados = document.getElementById('dirResaltados');
    const conteo = document.getElementById('dirConteo');
    const vacio = document.getElementById('dirVacio');
    let categoria = '';
    const normalizar = (s: string) =>
      s
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .toLowerCase()
        .trim();

    function filtrar() {
      const palabras = normalizar(buscar?.value ?? '').split(/\s+/).filter(Boolean);
      const feria = soloFeria?.getAttribute('aria-pressed') === 'true';
      let n = 0;
      for (const it of items) {
        const ok =
          (!categoria || it.dataset.cat === categoria) &&
          (!feria || it.dataset.feria === '1') &&
          palabras.every((p) => it.dataset.texto!.includes(p));
        it.hidden = !ok;
        if (ok) n++;
      }
      if (conteo) conteo.textContent = `${n} ${n === 1 ? 'emprendimiento' : 'emprendimientos'}`;
      if (vacio) vacio.hidden = n > 0;
      // Al buscar o filtrar, las franjas estorban: solo se ve el resultado.
      if (resaltados) resaltados.hidden = !!(palabras.length || categoria || feria);
    }
    const bajar = () => document.getElementById('muro')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });

    buscar?.addEventListener('input', filtrar);
    teclas.forEach((t) =>
      t.addEventListener('click', () => {
        categoria = t.dataset.filtroCat ?? '';
        teclas.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
        filtrar();
        if (categoria) bajar();
      }),
    );
    soloFeria?.addEventListener('click', () => {
      soloFeria.setAttribute('aria-pressed', String(soloFeria.getAttribute('aria-pressed') !== 'true'));
      filtrar();
      bajar();
    });
  }
</script>

<style>
  .directorio { padding: 56px 0 100px; scroll-margin-top: 64px; }

  .franja { margin-bottom: 64px; }
  .franja-titulo { font-size: clamp(40px, 5vw, 64px); margin-bottom: 6px; }
  .franja-bajada { font-family: var(--f-mano); font-size: 24px; color: var(--tinta-suave); margin-bottom: 24px; }
  .resaltados[hidden] { display: none; }

  .dir-head { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 28px; scroll-margin-top: 84px; }
  .dir-head h2 { font-size: clamp(48px, 6vw, 84px); }
  .dir-conteo { font-size: 24px; transform: rotate(-3deg); background: var(--mango); }

  .lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 34px 26px; align-items: start; }
  @media (max-width: 640px) { .lista { grid-template-columns: 1fr; gap: 28px; } }
  .dir-item[hidden] { display: none; }

  .vacio { max-width: 620px; margin: 20px auto 0; padding: 26px 28px; text-align: center; font-size: 18px; }
  .vacio-titulo { font-family: var(--f-letrero); font-size: 34px; line-height: 1; margin-bottom: 8px; }
  .vacio a { text-decoration: underline; font-weight: 700; }
  .vacio[hidden] { display: none; }
</style>
