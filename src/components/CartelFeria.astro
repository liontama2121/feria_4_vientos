---
// Cartel de la feria activa, arriba del todo de la landing: fecha, conjuntos donde se hace,
// puestos libres por conjunto, cuenta regresiva y "Inscribe tu emprendimiento".
// El toldo lleva las rayas de los conjuntos que participan. Si hay más ferias próximas,
// salen debajo como carteles pequeños.
import type { Fecha, Torre } from '../lib/db';
import type { TorreId } from '../lib/constantes';
import { aceptaInscripciones, diaMes, fechaLarga, rangoHoras } from '../lib/fechas';
import { pesos } from '../lib/ferias';

interface Props {
  ferias: Fecha[];
  torres: Torre[];
  /** Puestos ocupados por feria y conjunto. */
  ocupacion: Record<string, Partial<Record<TorreId, number>>>;
}
const { ferias, torres, ocupacion } = Astro.props;
const [feria, ...otras] = ferias;
const COLOR: Record<string, string> = { mistral: 'var(--hierbabuena)', gregal: 'var(--lulo)', austro: 'var(--pitahaya)', cierzo: 'var(--mora)' };

function conjuntosDe(f: Fecha) {
  return (f.conjuntos?.length ? f.conjuntos : []).map((id) => torres.find((t) => t.id === id)).filter((t): t is Torre => !!t);
}
const participantes = feria ? conjuntosDe(feria) : [];
// Toldo con las rayas de los conjuntos que participan (o los cuatro).
const rayas = (participantes.length ? participantes.map((t) => t.id) : torres.map((t) => t.id)).map((id) => COLOR[id] ?? 'var(--mango)');
const ancho = 44;
const toldo = `repeating-linear-gradient(90deg, ${rayas.flatMap((c, i) => [`${c} ${i * 2 * ancho}px ${(i * 2 + 1) * ancho}px`, `#fff ${(i * 2 + 1) * ancho}px ${(i * 2 + 2) * ancho}px`]).join(', ')})`;
const libres = (f: Fecha, id: TorreId) => {
  const cupo = f.cupos?.[id] ?? 0;
  return cupo > 0 ? Math.max(0, cupo - (ocupacion[f.id]?.[id] ?? 0)) : null;
};
const totalCupos = feria ? participantes.reduce((s, t) => s + (feria.cupos?.[t.id] ?? 0), 0) : 0;
const totalLibres = feria ? participantes.reduce((s, t) => s + (libres(feria, t.id) ?? 0), 0) : 0;
const abierta = feria ? aceptaInscripciones(feria) : false;
const inicio = feria ? `${feria.fecha}T${feria.hora_inicio}:00-05:00` : '';
const fin = feria ? `${feria.fecha}T${feria.hora_fin}:00-05:00` : '';
const lista = (ts: Torre[]) => (ts.length > 1 ? `${ts.slice(0, -1).map((t) => t.nombre).join(', ')} y ${ts.at(-1)!.nombre}` : (ts[0]?.nombre ?? ''));
---

{
  feria && (
    <section class="cartel-feria" id="feria" aria-labelledby="cartel-titulo">
      <div class="cartel-toldo" style={`background:${toldo}`} aria-hidden="true" />
      <div class="wrap">
        <div class="cartel letrero">
          <div class="cartel-dia" aria-hidden="true">
            <span class="dd">{diaMes(feria.fecha).dd}</span>
            <span class="mm">{diaMes(feria.fecha).mm}</span>
          </div>

          <div class="cartel-texto">
            <h2 id="cartel-titulo">{feria.titulo}</h2>
            <p class="cuando">
              {fechaLarga(feria.fecha)} · {rangoHoras(feria)}
            </p>
            {participantes.length > 0 && (
              <>
                <p class="donde">Se hace en {participantes.length === 4 ? 'los cuatro conjuntos' : lista(participantes)}</p>
                <ul class="cartel-conjuntos" aria-label="Conjuntos y puestos libres">
                  {participantes.map((t) => {
                    const l = libres(feria, t.id);
                    return (
                      <li data-conjunto={t.id}>
                        <span class="c-nombre">{t.nombre}</span>
                        {l !== null && <span class="c-libres">{l === 0 ? 'lleno' : `${l} ${l === 1 ? 'puesto libre' : 'puestos libres'}`}</span>}
                      </li>
                    );
                  })}
                  {torres
                    .filter((t) => !participantes.includes(t))
                    .map((t) => (
                      <li data-conjunto={t.id} class="no-va">
                        <span class="c-nombre">{t.nombre}</span>
                        <span class="c-libres">esta vez no</span>
                      </li>
                    ))}
                </ul>
              </>
            )}
          </div>

          <div class="cartel-lado">
            <div class="cuenta" data-inicio={inicio} data-fin={fin} role="timer" aria-live="off">
              <p class="cuenta-titulo" data-cuenta-titulo>Faltan</p>
              <div class="cuenta-numeros" data-cuenta-numeros>
                <span><b data-u="d">--</b> días</span>
                <span><b data-u="h">--</b> horas</span>
                <span><b data-u="m">--</b> min</span>
              </div>
            </div>
            {totalCupos > 0 && (
              <p class="cupos-total">
                {totalLibres === 0 ? 'Puestos llenos: queda lista de espera' : `Quedan ${totalLibres} de ${totalCupos} puestos`}
              </p>
            )}
            {abierta ? (
              <a class="boton boton-tinta cartel-cta" href={`/participar?feria=${encodeURIComponent(feria.id)}`}>
                Inscribe tu emprendimiento
              </a>
            ) : (
              <a class="boton cartel-cta" href="#reparto">
                ¿Quién va a cada conjunto?
              </a>
            )}
            <p class="valor">{abierta ? `Participar: ${pesos(feria.valor ?? 0)} · el comité te ubica` : 'Inscripciones cerradas'}</p>
          </div>
        </div>

        {otras.length > 0 && (
          <div class="otras">
            <h3 class="otras-titulo">Próximas ferias</h3>
            <ul class="otras-lista">
              {otras.map((f) => {
                const ts = conjuntosDe(f);
                return (
                  <li class="otra" data-conjunto={ts[0]?.id}>
                    <span class="otra-dia">
                      <b>{diaMes(f.fecha).dd}</b> {diaMes(f.fecha).mm}
                    </span>
                    <span class="otra-texto">
                      <b>{f.titulo}</b>
                      <span>{ts.length ? lista(ts) : rangoHoras(f)}</span>
                    </span>
                    {aceptaInscripciones(f) && (
                      <a class="otra-cta" href={`/participar?feria=${encodeURIComponent(f.id)}`}>
                        Inscribirme
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  // Cuenta regresiva hasta el inicio (hora de Bogotá). Se actualiza cada 20 s: los minutos bastan.
  document.querySelectorAll<HTMLElement>('.cuenta[data-inicio]').forEach((caja) => {
    const inicio = Date.parse(caja.dataset.inicio!);
    const fin = Date.parse(caja.dataset.fin!);
    const titulo = caja.querySelector<HTMLElement>('[data-cuenta-titulo]')!;
    const numeros = caja.querySelector<HTMLElement>('[data-cuenta-numeros]')!;
    const u = (k: string) => caja.querySelector<HTMLElement>(`[data-u="${k}"]`)!;
    const pintar = () => {
      const ahora = Date.now();
      if (ahora >= inicio) {
        titulo.textContent = ahora < fin ? '¡Es hoy! La feria ya empezó' : 'La feria de hoy ya terminó';
        numeros.hidden = true;
        return false;
      }
      const s = Math.floor((inicio - ahora) / 1000);
      u('d').textContent = String(Math.floor(s / 86400));
      u('h').textContent = String(Math.floor((s % 86400) / 3600)).padStart(2, '0');
      u('m').textContent = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
      return true;
    };
    if (pintar()) {
      const t = setInterval(() => pintar() || clearInterval(t), 20_000);
    }
  });
</script>

<style>
  .cartel-feria { background: var(--tinta); padding-bottom: 28px; scroll-margin-top: 60px; }
  .cartel-toldo {
    --feston: 16px; height: 46px;
    -webkit-mask: radial-gradient(circle at 22px 0, #000 22px, transparent 22.5px) bottom left / 44px var(--feston) repeat-x, linear-gradient(#000 0 0) top / 100% calc(100% - var(--feston)) no-repeat;
    mask: radial-gradient(circle at 22px 0, #000 22px, transparent 22.5px) bottom left / 44px var(--feston) repeat-x, linear-gradient(#000 0 0) top / 100% calc(100% - var(--feston)) no-repeat;
  }
  .cartel {
    display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(260px, 340px); gap: 28px; align-items: center;
    margin-top: 6px; padding: 26px 28px; border-color: var(--mango); box-shadow: 0 30px 50px -30px rgba(0, 0, 0, .6);
  }
  .cartel-dia { width: 116px; height: 116px; border-radius: 18px; background: var(--mango); border: 4px solid var(--tinta); display: grid; place-content: center; text-align: center; transform: rotate(-4deg); }
  .cartel-dia .dd { font-family: var(--f-letrero); font-size: 60px; line-height: .85; }
  .cartel-dia .mm { font-family: var(--f-letrero); font-size: 22px; }
  h2 { font-size: clamp(34px, 4.4vw, 62px); margin-bottom: 8px; }
  .cuando { font-size: 20px; font-weight: 800; }
  .donde { font-family: var(--f-mano); font-size: 25px; line-height: 1.1; margin: 8px 0 10px; color: var(--tinta-suave); }
  .cartel-conjuntos { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; }
  .cartel-conjuntos li { display: inline-flex; align-items: baseline; gap: 8px; padding: 6px 14px 6px 12px; border-radius: 999px; background: color-mix(in srgb, var(--c) 14%, #fff); border: 2.5px solid var(--c); }
  .cartel-conjuntos li.no-va { background: var(--papel); border-style: dashed; }
  .c-nombre { font-family: var(--f-letrero); font-size: 19px; color: var(--tinta); display: inline-flex; align-items: center; gap: 7px; }
  .c-nombre::before { content: ''; width: 11px; height: 11px; border-radius: 3px; background: var(--c); align-self: center; }
  .c-libres { font-size: 13.5px; font-weight: 800; color: var(--tinta-suave); }

  .cartel-lado { display: grid; gap: 12px; justify-items: stretch; text-align: center; }
  .cuenta { background: var(--tinta); color: var(--papel); border-radius: 16px; padding: 12px 14px 14px; }
  .cuenta-titulo { font-family: var(--f-mano); font-size: 22px; color: var(--mango); line-height: 1.1; }
  .cuenta-numeros { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 4px; font-size: 13px; font-weight: 700; color: #E4DFF2; }
  .cuenta-numeros[hidden] { display: none; }
  .cuenta-numeros span { display: grid; }
  .cuenta-numeros b { font-family: var(--f-letrero); font-weight: 400; font-size: 38px; line-height: 1; color: var(--papel); font-variant-numeric: tabular-nums; }
  .cupos-total { font-weight: 800; font-size: 16px; }
  .cartel-cta { width: 100%; font-size: 21px; white-space: normal; text-align: center; }
  .valor { font-size: 13.5px; font-weight: 700; color: var(--tinta-suave); }

  .otras { margin-top: 18px; color: var(--papel); }
  .otras-titulo { font-family: var(--f-mano); font-size: 26px; font-weight: 400; color: var(--mango); margin-bottom: 8px; }
  .otras-lista { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; padding: 0; margin: 0; }
  .otra { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 16px; background: var(--papel); color: var(--tinta); border-left: 0; box-shadow: inset 0 0 0 2.5px var(--c, var(--mango)); }
  .otra-dia { width: 54px; height: 54px; border-radius: 12px; display: grid; place-content: center; text-align: center; background: var(--c, var(--mango)); color: #fff; font-family: var(--f-letrero); font-size: 14px; line-height: 1; }
  .otra[data-conjunto='gregal'] .otra-dia, .otra:not([data-conjunto]) .otra-dia { color: var(--tinta); }
  .otra-dia b { font-weight: 400; font-size: 24px; display: block; }
  .otra-texto { display: grid; min-width: 0; }
  .otra-texto b { font-family: var(--f-letrero); font-weight: 400; font-size: 18px; overflow-wrap: anywhere; }
  .otra-texto span { font-size: 13px; font-weight: 700; color: var(--tinta-suave); }
  .otra-cta { font-weight: 800; font-size: 14px; text-decoration: underline; text-decoration-thickness: 2px; white-space: nowrap; }

  @media (max-width: 1000px) {
    .cartel { grid-template-columns: auto minmax(0, 1fr); }
    .cartel-lado { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; align-items: center; text-align: left; }
    .cartel-lado .cuenta { grid-row: span 2; text-align: center; }
  }
  @media (max-width: 640px) {
    .cartel-feria { padding-bottom: 18px; }
    .cartel-toldo { height: 34px; --feston: 12px; }
    .cartel { grid-template-columns: 1fr; gap: 16px; padding: 18px 16px; }
    .cartel-dia { position: absolute; right: 12px; top: -18px; width: 74px; height: 74px; border-width: 3px; }
    .cartel-dia .dd { font-size: 36px; }
    .cartel-dia .mm { font-size: 15px; }
    .cartel { position: relative; }
    h2 { padding-right: 76px; font-size: 32px; }
    .cuando { font-size: 16px; }
    .donde { font-size: 22px; }
    .cartel-cta { font-size: 18px; padding-inline: 14px; }
    .cartel-lado { grid-template-columns: 1fr; text-align: center; }
    .cartel-lado .cuenta { grid-row: auto; }
    .otras-lista { grid-auto-flow: column; grid-auto-columns: 84%; grid-template-columns: none; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    .otra { scroll-snap-align: start; }
  }
</style>
