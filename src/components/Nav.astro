---
import Molinete from './Molinete.astro';
import type { Torre } from '../lib/db';

interface Props {
  torres: Torre[];
  /** Sin feria activa no hay secciones por conjunto a las cuales saltar. */
  feria: boolean;
}
const { torres, feria } = Astro.props;
---

<nav class="nav" aria-label="Principal">
  <div class="wrap nav-inner">
    <a href="/" class="nav-marca" aria-label="4 Vientos, inicio">
      <Molinete size={34} />
      <span>4 Vientos</span>
    </a>
    {
      feria && (
        <div class="nav-conjuntos">
          {torres.map((t) => (
            <a href={`#${t.id}`} class="nav-conjunto sello" data-conjunto={t.id}>
              {t.nombre}
            </a>
          ))}
        </div>
      )
    }
    <div class="nav-acciones">
      <a href="#directorio" class="nav-link">Directorio</a>
      <a href="#participar" class="nav-link nav-ocultable">Participar</a>
      <a href="/admin" class="boton nav-panel">Panel</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--xerox);
    color: var(--papel);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .nav-marca {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 30px;
    text-transform: uppercase; line-height: 1; letter-spacing: .005em;
    white-space: nowrap;
  }
  .nav-conjuntos { display: flex; gap: 6px; }
  .nav-conjunto {
    padding: 6px 10px; background: var(--stock); color: var(--xerox);
    transform: rotate(-1deg); transition: transform .25s var(--ease);
  }
  .nav-conjunto:nth-child(even) { transform: rotate(1.2deg); }
  .nav-conjunto:hover { transform: translateY(-2px) rotate(0); }
  .nav-acciones { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    font-family: var(--f-display); font-stretch: 70%; font-weight: 800; font-size: 19px; text-transform: uppercase;
    padding: 10px 12px; min-height: 44px; display: inline-flex; align-items: center;
  }
  .nav-link:hover { color: var(--verde); }
  .nav-panel { min-height: 40px; padding: 8px 14px; font-size: 18px; margin-left: 8px; }
  @media (max-width: 980px) { .nav-conjuntos { display: none; } }
  @media (max-width: 520px) { .nav-ocultable { display: none; } .nav-marca { font-size: 26px; } }
</style>
