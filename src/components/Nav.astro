---
import Molinete from './Molinete.astro';
import type { Torre } from '../lib/db';

interface Props {
  torres: Torre[];
  /** Sin feria activa no hay secciones por conjunto a las cuales saltar. */
  feria: boolean;
}
const { torres, feria } = Astro.props;
---

<nav class="nav" aria-label="Principal">
  <div class="wrap nav-inner">
    <a href="/" class="nav-marca" aria-label="4 Vientos, inicio">
      <Molinete size={32} />
      <span>4 Vientos</span>
    </a>
    {
      feria && (
        <div class="nav-conjuntos">
          {torres.map((t) => (
            <a href={`#${t.id}`} class="nav-conjunto" data-conjunto={t.id}>
              <span class="led" aria-hidden="true" />
              {t.nombre}
            </a>
          ))}
        </div>
      )
    }
    <div class="nav-acciones">
      <a href="#muro" class="nav-link">Directorio</a>
      <a href="#participar" class="nav-link nav-ocultable">Participar</a>
      <a href="/admin" class="boton nav-panel">Panel</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: linear-gradient(180deg, #2C3136, var(--grafito));
    color: #F2F4F5;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .06) inset, 0 6px 16px -10px rgba(0, 0, 0, .6);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .nav-marca {
    display: flex; align-items: center; gap: 10px; white-space: nowrap;
    font-family: var(--f-placa); font-weight: 800; font-size: 28px; text-transform: uppercase; letter-spacing: .03em; line-height: 1;
  }
  .nav-conjuntos { display: flex; gap: 6px; }
  .nav-conjunto {
    display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 6px 12px;
    font-family: var(--f-placa); font-weight: 700; font-size: 16px; text-transform: uppercase; letter-spacing: .04em;
    border-radius: 6px; background: rgba(255, 255, 255, .06);
  }
  .nav-conjunto:hover { background: rgba(255, 255, 255, .14); }
  .nav-acciones { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    font-family: var(--f-placa); font-weight: 700; font-size: 19px; text-transform: uppercase; letter-spacing: .03em;
    padding: 10px 12px; min-height: 44px; display: inline-flex; align-items: center;
  }
  .nav-link:hover { color: var(--luz); }
  .nav-panel { min-height: 40px; padding: 8px 16px; font-size: 17px; margin-left: 8px; }
  @media (max-width: 1000px) { .nav-conjuntos { display: none; } }
  @media (max-width: 520px) { .nav-ocultable { display: none; } .nav-marca { font-size: 24px; } }
</style>
