---
// Molinillo de 4 aspas: el logo de la feria (versión refinada del promo).
// Cada aspa es un viento: Mistral, Gregal, Austro, Cierzo.
interface Props {
  size?: number;
  spin?: boolean;
  class?: string;
  label?: string;
}
const { size = 36, spin = false, class: className = '', label } = Astro.props;
---

<svg
  class:list={['molinete', { girando: spin }, className]}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d="M100 100 C100 40 130 20 160 20 C140 50 130 80 100 100Z" fill="#1E9C8C"></path>
  <path d="M100 100 C160 100 180 130 180 160 C150 140 120 130 100 100Z" fill="#E8641B"></path>
  <path d="M100 100 C100 160 70 180 40 180 C60 150 70 120 100 100Z" fill="#E3287A"></path>
  <path d="M100 100 C40 100 20 70 20 40 C50 60 80 70 100 100Z" fill="#7B3FE4"></path>
  <circle cx="100" cy="100" r="9" fill="#1A1633"></circle>
  <circle cx="100" cy="100" r="4" fill="#FFF7EA"></circle>
</svg>

<style>
  .molinete { display: block; flex: 0 0 auto; }
  .girando { animation: girar 6s linear infinite; }
</style>
