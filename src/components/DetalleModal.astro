---
// Modal "Ver más": descripción larga, galería, redes, calificaciones y reporte. Se abre desde
// cualquier botón con [data-detalle="slug"] (cards de torre y vitrina); con data-ir="calificar"
// baja directo a las estrellas.
import { categoria, dominioWeb, enlacesRedes, iniciales, ICONOS, LIMITES, MOTIVOS_REPORTE } from '../lib/constantes';
import type { EmprendedorPublico, Torre } from '../lib/db';

interface Props {
  emprendedores: EmprendedorPublico[];
  torres: Torre[];
  /** Slug cuya ficha se abre al cargar (link /e/<slug>). */
  abrir?: string;
}
const { emprendedores, torres, abrir } = Astro.props;

const datos = Object.fromEntries(
  emprendedores.map((e) => {
    const t = torres.find((x) => x.id === e.torre) ?? torres[0];
    const cat = categoria(e.categoria, Astro.locals.categorias);
    return [
      e.slug,
      {
        nombre: e.nombre_emprendimiento,
        vecino: e.nombre_vecino,
        apto: e.apartamento,
        torre: t.nombre,
        conjunto: t.id,
        color: t.color_hex,
        claro: t.color_claro,
        cat: cat.label,
        emoji: iniciales(e.nombre_emprendimiento || e.nombre_vecino),
        corta: e.descripcion_corta,
        larga: e.descripcion_larga,
        fotos: [e.foto_principal, ...e.galeria].filter(Boolean),
        redes: enlacesRedes(e),
        whatsapp: e.whatsapp,
        web: e.pagina_web,
        webDominio: e.pagina_web ? dominioWeb(e.pagina_web) : '',
        calif: e.calificacion ?? { promedio: 0, total: 0, resenas: [] },
      },
    ];
  }),
);
const json = JSON.stringify({ datos, iconos: ICONOS }).replace(/</g, '\\u003c');
---

<dialog class="detalle" id="detalle" aria-labelledby="detalle-nombre" data-abrir={abrir}>
  <button type="button" class="cerrar" data-cerrar aria-label="Cerrar">
    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  <div class="detalle-media">
    <img id="detalle-foto" alt="" hidden />
    <span id="detalle-emoji" class="emoji" aria-hidden="true"></span>
    <div id="detalle-miniaturas" class="miniaturas"></div>
  </div>
  <div class="detalle-body">
    <span id="detalle-chip" class="chip"></span>
    <span id="detalle-cat" class="cat"></span>
    <h3 id="detalle-nombre"></h3>
    <div id="detalle-by" class="by"></div>
    <div id="detalle-texto" class="texto"></div>
    <a id="detalle-web" class="web" target="_blank" rel="noopener" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONOS.web}></path></svg>
      <span>Entra aquí <small id="detalle-web-dominio"></small></span>
      <span aria-hidden="true">→</span>
    </a>
    <div id="detalle-redes" class="redes"></div>
    <div class="compartir">
      <button type="button" id="detalle-compartir" class="btn-compartir">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
        Compartir
      </button>
      <a id="detalle-compartir-wsp" class="btn-compartir wsp" target="_blank" rel="noopener">Enviar por WhatsApp</a>
      <span id="detalle-compartir-msg" class="msg" role="status" aria-live="polite"></span>
    </div>
  </div>

  <section class="opiniones" id="detalle-opiniones" aria-labelledby="opiniones-titulo">
    <div class="opiniones-head">
      <h4 id="opiniones-titulo">Calificaciones</h4>
      <div class="resumen" id="calif-resumen"></div>
    </div>
    <div class="resenas" id="calif-resenas"></div>

    <form class="calificar" id="form-calificar" novalidate>
      <fieldset class="picker" id="calif-picker">
        <legend id="calif-legend">¿Cómo te fue? Califica de 1 a 5</legend>
        {
          [1, 2, 3, 4, 5].map((n) => (
            <label class="estrella">
              <input type="radio" name="estrellas" value={n} required />
              <svg viewBox="0 0 24 24" aria-hidden="true" class="estrella-svg"><path d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.7z"></path></svg>
              <span class="sr-only-f4v">{n} {n === 1 ? 'estrella' : 'estrellas'}</span>
            </label>
          ))
        }
      </fieldset>
      <div class="fila">
        <label class="campo">
          <span>Tu nombre <small>(opcional)</small></span>
          <input name="nombre" maxlength="60" autocomplete="given-name" placeholder="Ej: Laura" />
        </label>
        <label class="campo">
          <span>Tu conjunto <small>(opcional)</small></span>
          <select name="conjunto">
            <option value="">Prefiero no decir</option>
            {torres.map((t) => <option value={t.id}>{t.nombre}</option>)}
          </select>
        </label>
      </div>
      <label class="campo">
        <span>Comentario <small>(opcional, se publica)</small></span>
        <textarea name="comentario" rows="2" maxlength={LIMITES.comentario} placeholder="¿Qué te gustó? Sé respetuoso: es un vecino."></textarea>
      </label>
      <label class="trampa" aria-hidden="true">Sitio <input name="sitio" tabindex="-1" autocomplete="off" /></label>
      <div class="acciones">
        <button type="submit" class="btn-calificar">Enviar calificación</button>
        <span class="msg" id="calif-msg" role="status" aria-live="polite"></span>
      </div>
    </form>

    <details class="reportar" id="detalle-reportar">
      <summary>Reportar un problema grave</summary>
      <form id="form-reportar" novalidate data-max={LIMITES.evidencias}>
        <p class="aviso">
          Solo para cosas serias que afecten a la comunidad (estafa, peligro, acoso…). Es anónimo y privado: solo el comité ve el
          reporte y las fotos, nunca el vecino ni la landing. Para una mala experiencia normal, usa las estrellas.
        </p>
        <label class="campo">
          <span>Motivo</span>
          <select name="motivo" required>
            <option value="">Elige el motivo…</option>
            {MOTIVOS_REPORTE.map((m) => <option value={m.id}>{m.label}</option>)}
          </select>
        </label>
        <div class="campo">
          <span>Fotos de evidencia <small>(1 a {LIMITES.evidencias}: capturas de chat, del pago, del producto…)</small></span>
          <label class="subir-evidencia">
            <input type="file" id="rep-fotos" accept="image/jpeg,image/png,image/webp" multiple />
            <span>Elegir fotos</span>
          </label>
          <div class="evidencias" id="rep-previas"></div>
        </div>
        <label class="campo">
          <span>Nota <small>(opcional)</small></span>
          <textarea name="detalle" rows="2" maxlength={LIMITES.detalleReporte} placeholder="Si quieres, cuéntale al comité en pocas palabras qué pasó."></textarea>
        </label>
        <label class="trampa" aria-hidden="true">Sitio <input name="sitio" tabindex="-1" autocomplete="off" /></label>
        <div class="acciones">
          <button type="submit" class="btn-reportar">Enviar reporte al comité</button>
          <span class="msg" id="rep-msg" role="status" aria-live="polite"></span>
        </div>
      </form>
    </details>
  </section>
</dialog>

<script type="application/json" id="detalle-datos" set:html={json} />

<script>
  import type { ResumenCalificaciones } from '../lib/db';
  import { optimizarFoto } from '../lib/optimizarFoto';

  type Red = { red: 'whatsapp' | 'instagram' | 'tiktok' | 'facebook'; url: string; label: string };
  type Detalle = {
    nombre: string; vecino: string; apto: string; torre: string; conjunto: string; color: string; claro: string;
    cat: string; emoji: string; corta: string; larga: string; fotos: string[]; redes: Red[]; whatsapp: string; web: string; webDominio: string;
    calif: ResumenCalificaciones;
  };

  const { datos, iconos } = JSON.parse(document.getElementById('detalle-datos')!.textContent!) as {
    datos: Record<string, Detalle>;
    iconos: Record<string, string>;
  };
  const dialog = document.getElementById('detalle') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  const foto = $('detalle-foto') as HTMLImageElement;
  const emoji = $('detalle-emoji');
  const mini = $('detalle-miniaturas');

  function verFoto(src: string, nombre: string) {
    foto.src = src;
    foto.alt = `Foto de ${nombre}`;
    foto.hidden = false;
    emoji.hidden = true;
    mini.querySelectorAll('button').forEach((b) => b.classList.toggle('activa', b.dataset.src === src));
  }

  function abrir(slug: string) {
    const d = datos[slug];
    if (!d) return;
    // La ficha toma el color de su conjunto (body.plaza: [data-conjunto] → --c)
    dialog.dataset.conjunto = d.conjunto;
    $('detalle-chip').textContent = d.torre;
    $('detalle-cat').textContent = d.cat;
    $('detalle-nombre').textContent = d.nombre;
    $('detalle-by').textContent = `${d.vecino} · ${d.torre}${d.apto ? ` · Apto ${d.apto}` : ''}`;

    const texto = $('detalle-texto');
    texto.replaceChildren(
      ...(d.larga || d.corta).split(/\n{2,}/).map((p) => {
        const el = document.createElement('p');
        el.textContent = p.trim();
        return el;
      }),
    );

    mini.replaceChildren();
    if (d.fotos.length) {
      d.fotos.forEach((src, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.src = src;
        b.setAttribute('aria-label', `Ver foto ${i + 1}`);
        const img = document.createElement('img');
        img.src = src;
        img.alt = '';
        b.append(img);
        b.addEventListener('click', () => verFoto(src, d.nombre));
        mini.append(b);
      });
      mini.hidden = d.fotos.length < 2;
      verFoto(d.fotos[0], d.nombre);
    } else {
      foto.hidden = true;
      emoji.hidden = false;
      emoji.textContent = d.emoji;
      mini.hidden = true;
    }

    const web = $('detalle-web') as HTMLAnchorElement;
    web.hidden = !d.web;
    if (d.web) {
      web.href = d.web;
      web.setAttribute('aria-label', `Entrar a la página web de ${d.nombre}`);
      $('detalle-web-dominio').textContent = d.webDominio;
    }

    const redes = $('detalle-redes');
    redes.replaceChildren(
      ...d.redes.map((r) => {
        const a = document.createElement('a');
        a.href = r.red === 'whatsapp' ? `${r.url}?text=${encodeURIComponent(`Hola ${d.vecino.split(' ')[0]} 👋 Te vi en la Feria 4 Vientos y quiero saber más de ${d.nombre}.`)}` : r.url;
        a.target = '_blank';
        a.rel = 'noopener';
        a.className = `red red-${r.red}`;
        a.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${iconos[r.red]}"/></svg>`;
        a.append(r.red === 'whatsapp' ? 'Escribir por WhatsApp' : r.label);
        return a;
      }),
    );

    actual = slug;
    const link = linkDe(slug);
    ($('detalle-compartir-wsp') as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(`Mira ${d.nombre} en la Feria 4 Vientos 👉 ${link}`)}`;
    $('detalle-compartir-msg').textContent = '';
    pintarCalif(d.calif);
    prepararFormularios(slug);
    dialog.showModal();
  }

  // ───── Compartir: cada emprendimiento tiene su link /e/<slug> ─────
  const linkDe = (slug: string) => `${location.origin}/e/${encodeURIComponent(slug)}`;
  $('detalle-compartir').addEventListener('click', async () => {
    const d = datos[actual];
    const url = linkDe(actual);
    const msg = $('detalle-compartir-msg');
    try {
      if (navigator.share) {
        await navigator.share({ title: d.nombre, text: `Mira ${d.nombre} en la Feria 4 Vientos`, url });
        return;
      }
      await navigator.clipboard.writeText(url);
      msg.textContent = '✓ Link copiado';
    } catch (e) {
      // Cancelar el menú de compartir no es un error.
      if ((e as Error).name !== 'AbortError') msg.textContent = url;
    }
  });

  // ───── Calificaciones y reportes ─────
  let actual = '';
  const formCalif = $('form-calificar') as HTMLFormElement;
  const formRep = $('form-reportar') as HTMLFormElement;
  const califMsg = $('calif-msg');
  const repMsg = $('rep-msg');
  // Lo que este navegador ya calificó, solo para precargar el formulario (el servidor manda igual).
  const CLAVE_LOCAL = 'f4v_calificaciones';
  const leerMias = (): Record<string, number> => {
    try {
      return JSON.parse(localStorage.getItem(CLAVE_LOCAL) || '{}');
    } catch {
      return {};
    }
  };
  const guardarMia = (slug: string, n: number) => {
    try {
      localStorage.setItem(CLAVE_LOCAL, JSON.stringify({ ...leerMias(), [slug]: n }));
    } catch {
      // Navegación privada o almacenamiento bloqueado: no pasa nada.
    }
  };

  const estrellasTexto = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
  const fechaCorta = (iso: string) => new Date(iso).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });

  function pintarCalif(c: ResumenCalificaciones) {
    const resumen = $('calif-resumen');
    if (!c.total) {
      resumen.textContent = 'Aún nadie lo califica. ¡Sé el primero!';
    } else {
      const est = document.createElement('span');
      est.className = 'est';
      est.textContent = estrellasTexto(c.promedio);
      const num = document.createElement('strong');
      num.textContent = c.promedio.toFixed(1);
      resumen.replaceChildren(est, num, ` · ${c.total} ${c.total === 1 ? 'calificación' : 'calificaciones'}`);
    }
    $('calif-resenas').replaceChildren(
      ...c.resenas.map((r) => {
        const art = document.createElement('article');
        art.className = 'resena';
        const cab = document.createElement('div');
        cab.className = 'resena-cab';
        const est = document.createElement('span');
        est.className = 'est';
        est.textContent = estrellasTexto(r.estrellas);
        const quien = document.createElement('span');
        quien.textContent = `${r.nombre || 'Vecino'}${r.conjunto ? ` · ${r.conjunto}` : ''} · ${fechaCorta(r.creado_at)}`;
        cab.append(est, quien);
        const p = document.createElement('p');
        p.textContent = r.comentario;
        art.append(cab, p);
        return art;
      }),
    );
  }

  function prepararFormularios(slug: string) {
    formCalif.reset();
    formRep.reset();
    califMsg.textContent = '';
    repMsg.textContent = '';
    ($('detalle-reportar') as HTMLDetailsElement).open = false;
    evidencias = [];
    pintarEvidencias();
    const mia = leerMias()[slug];
    $('calif-legend').textContent = mia ? `Ya calificaste con ${mia} ★. Puedes cambiarla:` : '¿Cómo te fue? Califica de 1 a 5';
    if (mia) formCalif.querySelector<HTMLInputElement>(`input[name="estrellas"][value="${mia}"]`)!.checked = true;
  }

  async function enviar(url: string, datos: Record<string, unknown>) {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(datos) });
    const j = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(j.error || 'No se pudo enviar. Intenta de nuevo.');
    return j;
  }

  formCalif.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const campos = Object.fromEntries(new FormData(formCalif));
    const estrellas = Number(campos.estrellas);
    if (!estrellas) {
      califMsg.textContent = 'Elige las estrellas primero.';
      return;
    }
    const boton = formCalif.querySelector('button')!;
    boton.disabled = true;
    califMsg.textContent = 'Enviando…';
    try {
      const r = await enviar('/api/calificar', { ...campos, estrellas, slug: actual });
      datos[actual].calif = r.resumen;
      pintarCalif(r.resumen);
      guardarMia(actual, estrellas);
      $('calif-legend').textContent = `Ya calificaste con ${estrellas} ★. Puedes cambiarla:`;
      califMsg.textContent = r.actualizada ? '✓ Actualizamos tu calificación. ¡Gracias!' : '✓ ¡Gracias por calificar!';
      (formCalif.elements.namedItem('comentario') as HTMLTextAreaElement).value = '';
    } catch (e) {
      califMsg.textContent = (e as Error).message;
    }
    boton.disabled = false;
  });

  // Evidencias: se eligen (acumulando hasta el límite), se ven en miniatura y se pueden quitar.
  const MAX_EVIDENCIAS = Number(formRep.dataset.max);
  const inputFotos = $('rep-fotos') as HTMLInputElement;
  let evidencias: File[] = [];
  function pintarEvidencias() {
    $('rep-previas').replaceChildren(
      ...evidencias.map((f, i) => {
        const fig = document.createElement('figure');
        const img = document.createElement('img');
        img.src = URL.createObjectURL(f);
        img.alt = `Evidencia ${i + 1}`;
        img.onload = () => URL.revokeObjectURL(img.src);
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.textContent = '✕';
        quitar.setAttribute('aria-label', `Quitar evidencia ${i + 1}`);
        quitar.addEventListener('click', () => {
          evidencias.splice(i, 1);
          pintarEvidencias();
        });
        fig.append(img, quitar);
        return fig;
      }),
    );
  }
  inputFotos.addEventListener('change', () => {
    const nuevas = Array.from(inputFotos.files ?? []).filter((f) => /^image\/(jpeg|png|webp)$/.test(f.type));
    evidencias = [...evidencias, ...nuevas].slice(0, MAX_EVIDENCIAS);
    repMsg.textContent = nuevas.length + evidencias.length > MAX_EVIDENCIAS ? `Máximo ${MAX_EVIDENCIAS} fotos.` : '';
    inputFotos.value = '';
    pintarEvidencias();
  });

  formRep.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(formRep);
    if (!fd.get('motivo')) {
      repMsg.textContent = 'Elige el motivo.';
      return;
    }
    if (!evidencias.length) {
      repMsg.textContent = 'Adjunta al menos una foto como evidencia.';
      return;
    }
    const boton = formRep.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    boton.disabled = true;
    repMsg.textContent = 'Preparando fotos…';
    try {
      fd.set('slug', actual);
      for (const [i, f] of evidencias.entries()) {
        const blob = await optimizarFoto(f);
        fd.append('fotos', blob, `evidencia-${i + 1}.${blob.type === 'image/webp' ? 'webp' : blob.type === 'image/png' ? 'png' : 'jpg'}`);
      }
      repMsg.textContent = 'Enviando…';
      const res = await fetch('/api/reportar', { method: 'POST', body: fd });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(j.error || 'No se pudo enviar. Intenta de nuevo.');
      formRep.reset();
      evidencias = [];
      pintarEvidencias();
      repMsg.textContent = '✓ Gracias. El comité lo revisará en privado.';
    } catch (e) {
      repMsg.textContent = (e as Error).message;
    }
    boton.disabled = false;
  });

  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-detalle]');
    if (!btn) return;
    abrir(btn.dataset.detalle!);
    if (btn.dataset.ir === 'calificar') $('detalle-opiniones').scrollIntoView({ block: 'start' });
  });
  dialog.querySelector('[data-cerrar]')!.addEventListener('click', () => dialog.close());
  // Llegó por el link /e/<slug>: la ficha abre sola. Al cerrarla, la URL vuelve a la portada.
  if (dialog.dataset.abrir && datos[dialog.dataset.abrir]) {
    abrir(dialog.dataset.abrir);
    dialog.addEventListener('close', () => history.replaceState(null, '', '/'), { once: true });
  }
  dialog.addEventListener('click', (ev) => {
    if (ev.target === dialog) dialog.close();
  });
</script>

<style>
  /* La ficha: el puesto de cerca. La foto grande y a color a la izquierda, el letrero a la derecha. */
  .detalle {
    width: min(1000px, calc(100vw - 24px)); max-height: calc(100dvh - 32px);
    margin: auto; padding: 0; border: 4px solid var(--c, var(--tinta)); overflow: auto;
    border-radius: var(--r-puesto);
    background: var(--papel); color: var(--tinta);
    box-shadow: 0 30px 60px -20px rgba(32, 24, 58, .7);
    overscroll-behavior: contain;
  }
  .detalle[open] { display: grid; grid-template-columns: 1.1fr 1fr; }
  .detalle::backdrop { background: rgba(32, 24, 58, .6); }
  @media (max-width: 760px) { .detalle[open] { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: no-preference) {
    .detalle[open] { animation: ficha .4s var(--ease) both; }
    @keyframes ficha { from { opacity: 0; transform: translateY(18px) scale(.98); } to { opacity: 1; transform: none; } }
  }

  .cerrar {
    position: sticky; top: 0; z-index: 4; grid-column: 1 / -1; justify-self: end;
    width: 48px; height: 48px; margin: 10px 10px -58px 0; border: 3px solid var(--tinta); border-radius: 50%;
    background: var(--papel); color: var(--tinta);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .cerrar .ico { width: 22px; height: 22px; stroke-width: 2.6; }
  .cerrar:hover { background: var(--mango); }

  .detalle-media { position: relative; min-height: 420px; display: flex; align-items: center; justify-content: center; background: var(--c, var(--mango)); }
  @media (max-width: 760px) { .detalle-media { min-height: 300px; } }
  .detalle-media > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .emoji { font-family: var(--f-letrero); font-size: 150px; line-height: .8; color: #fff; }
  .miniaturas { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; gap: 8px; overflow-x: auto; }
  .miniaturas[hidden] { display: none; }
  .miniaturas :global(button) { flex: 0 0 64px; height: 64px; padding: 0; border: 3px solid #fff; border-radius: 12px; overflow: hidden; opacity: .75; background: var(--tinta); }
