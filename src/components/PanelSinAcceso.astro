---
// Pantalla cuando se abre /admin sin un emprendimiento válido para editar.
import Molinete from './Molinete.astro';
---

<div class="sin-acceso">
  <div class="card">
    <Molinete size={72} spin />
    <h1>No encontramos ese emprendimiento</h1>
    <p>Puede que lo hayan eliminado o que el enlace esté incompleto. Elígelo desde la lista del comité.</p>
    <div class="acciones">
      <a class="btn btn-primary" href="/admin/comite">Ir al comité</a>
      <a class="btn btn-ghost" href="/">Volver a la feria</a>
    </div>
  </div>
</div>
