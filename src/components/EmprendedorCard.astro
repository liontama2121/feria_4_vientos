---
// Un emprendimiento = una plaquita del citófono: placa de acero con la etiqueta de nombre
// retroiluminada y el botón redondo de llamar (abre WhatsApp). Los nuevos brillan más.
import { ICONOS, categoria, dominioWeb, enlacesRedes, iniciales } from '../lib/constantes';
import type { EmprendedorPublico, Torre } from '../lib/db';

interface Props {
  e: EmprendedorPublico;
  torre: Torre;
  /** Muestra la marca "En la feria". */
  enFeria?: boolean;
}
const { e, torre, enFeria = false } = Astro.props;
const cat = categoria(e.categoria, Astro.locals.categorias);
// Instagram, TikTok, Facebook; el WhatsApp es el botón de llamar.
const redes = enlacesRedes(e).filter((r) => r.red !== 'whatsapp');
const calif = e.calificacion;
const llenas = calif ? Math.round(calif.promedio) : 0;
const wsp = `https://wa.me/57${e.whatsapp}?text=${encodeURIComponent(
  `Hola ${e.nombre_vecino.split(' ')[0]} 👋 Te encontré en el directorio de la Feria 4 Vientos y quiero saber más de ${e.nombre_emprendimiento}.`,
)}`;
---

<article class:list={['timbre placa', { nuevo: e.nuevo }]} data-conjunto={torre.id}>
  <button type="button" class="timbre-foto" data-detalle={e.slug} aria-label={`Ver la ficha de ${e.nombre_emprendimiento}`}>
    {
      e.foto_principal ? (
        <img src={e.foto_principal} alt="" loading="lazy" decoding="async" />
      ) : (
        <span class="iniciales" aria-hidden="true">{iniciales(e.nombre_emprendimiento || e.nombre_vecino)}</span>
      )
    }
  </button>

  <div class="timbre-cuerpo">
    <div class="plaquita">
      <h3>
        <button type="button" data-detalle={e.slug}>{e.nombre_emprendimiento}</button>
      </h3>
      <p class="quien">
        <span class="led" aria-hidden="true"></span>
        {e.nombre_vecino} · {torre.nombre}{e.apartamento && ` ${e.apartamento}`}
      </p>
    </div>

    <div class="marcas rotulo">
      <span>{cat.label}</span>
      {e.nuevo && <span class="marca marca-nuevo">Nuevo</span>}
      {enFeria && <span class="marca">En la feria</span>}
    </div>

    <p class="desc">{e.descripcion_corta}</p>

    <div class="timbre-pie">
      <button type="button" class="calif" data-detalle={e.slug} data-ir="calificar">
        {
          calif && calif.total > 0 ? (
            <>
              <span class="estrellas" aria-hidden="true">
                {[1, 2, 3, 4, 5].map((n) => (
                  <svg viewBox="0 0 24 24" class:list={['estrella', { llena: n <= llenas }]}>
                    <path d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.7z" />
                  </svg>
                ))}
              </span>
              <strong>{calif.promedio.toFixed(1)}</strong>
              <span class="cuantos">({calif.total})</span>
              <span class="sr-only-f4v">{`Calificación ${calif.promedio.toFixed(1)} de 5, ${calif.total} ${calif.total === 1 ? 'voto' : 'votos'}. Calificar`}</span>
            </>
          ) : (
            <span class="primero">Califícalo primero</span>
          )
        }
      </button>
      <div class="extras">
        {redes.map((r) => (
          <a href={r.url} target="_blank" rel="noopener" aria-label={`${r.label} de ${e.nombre_emprendimiento}`}>
            <svg viewBox="0 0 24 24" class="ico ico-lleno" aria-hidden="true">
              <path d={ICONOS[r.red]} />
            </svg>
          </a>
        ))}
        {
          e.pagina_web && (
            <a class="web" href={e.pagina_web} target="_blank" rel="noopener" title={dominioWeb(e.pagina_web)}>
              Web
            </a>
          )
        }
        <button type="button" class="boton boton-chico" data-detalle={e.slug}>Ficha</button>
      </div>
    </div>
  </div>

  <div class="timbre-llamar">
    <a class="llamar" href={wsp} target="_blank" rel="noopener" aria-label={`Llamar por WhatsApp a ${e.nombre_emprendimiento}`} data-llamar>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONOS.whatsapp} /></svg>
    </a>
    <span class="rotulo llamar-txt" aria-hidden="true">Llamar</span>
  </div>
</article>

<script>
  // Timbrar: la plaquita parpadea como el citófono cuando suena; WhatsApp abre igual.
  document.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-llamar]');
    const t = b?.closest<HTMLElement>('.timbre');
    if (!t) return;
    t.classList.remove('sonando');
    void t.offsetWidth;
    t.classList.add('sonando');
  });
</script>

<style>
  .timbre {
    display: grid; grid-template-columns: 92px minmax(0, 1fr) auto; gap: 16px; align-items: start;
    padding: 16px 16px 16px 16px;
  }
  @media (max-width: 480px) { .timbre { grid-template-columns: 64px minmax(0, 1fr) auto; gap: 12px; padding: 14px 12px; } }

  .timbre-foto {
    width: 100%; aspect-ratio: 1; padding: 0; border: 0; cursor: pointer; overflow: hidden;
    border-radius: 6px; background: var(--grafito);
    box-shadow: 0 0 0 3px var(--grafito), 0 0 0 5px var(--acero-borde), inset 0 2px 6px rgba(0, 0, 0, .5);
    display: flex; align-items: center; justify-content: center;
  }
  .timbre-foto img { width: 100%; height: 100%; object-fit: cover; }
  .iniciales { font-family: var(--f-lcd); font-size: 44px; color: var(--lcd); line-height: 1; }

  /* Etiqueta retroiluminada detrás del acrílico */
  .plaquita {
    background: linear-gradient(180deg, #FFFBEF, var(--luz));
    border-radius: var(--r-plaquita);
    padding: 10px 12px 8px;
    box-shadow: inset 0 0 0 1px rgba(35, 39, 43, .22), inset 0 6px 10px -6px rgba(255, 255, 255, .9), 0 0 0 3px #9AA2A7, 0 0 0 4px #E9EDEF;
  }
  .nuevo .plaquita {
    background: linear-gradient(180deg, #FFFDF5, var(--luz-fuerte));
    box-shadow: inset 0 0 0 1px rgba(35, 39, 43, .22), 0 0 0 3px #9AA2A7, 0 0 0 4px #E9EDEF, 0 0 22px 2px rgba(255, 223, 128, .75);
  }
  h3 { font-size: clamp(24px, 2.4vw, 30px); line-height: 1; margin-bottom: 4px; }
  h3 button { all: unset; cursor: pointer; overflow-wrap: anywhere; }
  h3 button:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  h3 button:focus-visible { outline: 3px solid var(--grafito); outline-offset: 2px; }
  .quien { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; color: var(--grafito-suave); }

  .marcas { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 10px 0 6px; font-size: 13.5px; }
  .marca { padding: 3px 8px 2px; border-radius: 4px; background: var(--grafito); color: #F2F4F5; }
  .marca-nuevo { background: var(--lcd-fondo); color: var(--lcd); font-family: var(--f-lcd); font-size: 18px; letter-spacing: .02em; line-height: 1; }
  .desc { font-size: 15.5px; line-height: 1.45; margin-bottom: 10px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .timbre-pie { display: flex; align-items: center; justify-content: space-between; gap: 8px 12px; flex-wrap: wrap; }
  .calif { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; font-weight: 600; }
  .estrellas { display: inline-flex; gap: 1px; }
  .estrella { width: 17px; height: 17px; fill: none; stroke: var(--grafito); stroke-width: 1.6; }
  .estrella.llena { fill: var(--grafito); }
  .calif strong { font-family: var(--f-placa); font-size: 20px; }
  .cuantos { font-size: 14px; color: var(--grafito-suave); }
  .primero { font-size: 14px; text-decoration: underline; text-decoration-thickness: 1px; }
  .extras { display: flex; align-items: center; gap: 4px; }
  .extras a { min-width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; }
  .extras a:hover { background: rgba(35, 39, 43, .1); }
  .extras .ico { width: 19px; height: 19px; }
  .web { font-family: var(--f-placa); font-weight: 700; text-transform: uppercase; padding: 0 8px; text-decoration: underline; }
  .boton-chico { min-height: 40px; padding: 6px 14px; font-size: 17px; margin-left: 4px; }

  .timbre-llamar { display: flex; flex-direction: column; align-items: center; gap: 8px; padding-top: 6px; }
  .llamar-txt { font-size: 13px; }

  @media (prefers-reduced-motion: no-preference) {
    .sonando .plaquita { animation: timbre .9s steps(2) 2; }
    .sonando .llamar { animation: llamando .9s ease 2; }
    @keyframes timbre { 50% { background: #FFFFFF; box-shadow: inset 0 0 0 1px rgba(35, 39, 43, .22), 0 0 0 3px #9AA2A7, 0 0 30px 6px rgba(255, 233, 168, .95); } }
    @keyframes llamando { 50% { transform: scale(1.08); } }
  }
</style>
