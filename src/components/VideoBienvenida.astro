---
// Pop-up con el video de JuanCode al entrar a la landing. Sale una vez por sesión del navegador
// (sessionStorage) y se cierra con ✕, "Entrar a la feria", Esc, clic afuera o al terminar el video.
// Arranca sin sonido (los navegadores bloquean el autoplay con audio); el botón 🔊 lo activa.
import { SITIO } from '../lib/sitio';
---

<div class="vb" id="videoBienvenida" role="dialog" aria-modal="true" aria-label="Video de bienvenida" hidden>
  <div class="vb-caja">
    <button type="button" class="vb-cerrar" data-vb-cerrar aria-label="Cerrar video">✕</button>
    <video
      class="vb-video"
      src="/video/hecho-por-juancode-9x16.mp4"
      muted
      playsinline
      preload="none"
    ></video>
    <div class="vb-acciones">
      <button type="button" class="vb-sonido" data-vb-sonido aria-pressed="false">🔇 Activar sonido</button>
      <button type="button" class="boton vb-entrar" data-vb-cerrar>Entrar a la feria</button>
    </div>
    {
      SITIO.juancodeUrl && (
        <a class="vb-link" href={SITIO.juancodeUrl} target="_blank" rel="noopener">
          Sitio web hecho por JuanCode · Cotice el suyo
        </a>
      )
    }
  </div>
</div>

<script>
  const CLAVE = 'f4v_video_visto';
  const caja = document.getElementById('videoBienvenida');
  const video = caja?.querySelector('video');

  function yaVisto() {
    try { return sessionStorage.getItem(CLAVE) === '1'; } catch { return false; }
  }

  if (caja && video && !yaVisto()) {
    const sonido = caja.querySelector<HTMLButtonElement>('[data-vb-sonido]')!;
    const anterior = document.activeElement as HTMLElement | null;

    const cerrar = () => {
      if (caja.hidden) return;
      video.pause();
      caja.hidden = true;
      document.documentElement.classList.remove('vb-abierto');
      document.removeEventListener('keydown', alTeclear);
      try { sessionStorage.setItem(CLAVE, '1'); } catch { /* modo privado: no pasa nada */ }
      anterior?.focus?.();
    };
    const alTeclear = (e: KeyboardEvent) => { if (e.key === 'Escape') cerrar(); };

    caja.querySelectorAll('[data-vb-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
    caja.addEventListener('click', (e) => { if (e.target === caja) cerrar(); });
    video.addEventListener('ended', cerrar);
    sonido.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.play().catch(() => {});
      sonido.setAttribute('aria-pressed', String(!video.muted));
      sonido.textContent = video.muted ? '🔇 Activar sonido' : '🔊 Sonido activado';
    });

    caja.hidden = false;
    document.documentElement.classList.add('vb-abierto');
    document.addEventListener('keydown', alTeclear);
    video.preload = 'auto';
    video.play().catch(() => { video.controls = true; });
    caja.querySelector<HTMLButtonElement>('.vb-cerrar')?.focus();
  }
</script>

<style>
  :global(html.vb-abierto) { overflow: hidden; }
  .vb {
    position: fixed; inset: 0; z-index: 1000;
    display: grid; place-items: center; padding: 16px;
    background: rgba(32, 24, 58, 0.82);
    backdrop-filter: blur(4px);
    animation: vb-entra 0.25s ease-out;
  }
  .vb[hidden] { display: none; }
  .vb-caja {
    position: relative;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    /* 9:16 que quepa en pantalla con los botones debajo */
    width: min(380px, calc((100dvh - 150px) * 9 / 16), 100%);
  }
  .vb-video {
    width: 100%; aspect-ratio: 9 / 16; object-fit: cover;
    border-radius: 18px; border: 3px solid var(--mango); background: #000;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }
  .vb-cerrar {
    position: absolute; top: -12px; right: -12px; z-index: 1;
    width: 44px; height: 44px; border-radius: 999px;
    border: 3px solid var(--tinta); background: var(--mango); color: var(--tinta);
    font-size: 20px; font-weight: 800; line-height: 1; cursor: pointer;
  }
  .vb-cerrar:active { transform: translateY(2px); }
  .vb-acciones { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .vb-sonido {
    border: 2px solid #fff; background: transparent; color: #fff;
    border-radius: 999px; padding: 10px 16px; font: inherit; font-weight: 700; cursor: pointer;
  }
  .vb-link { color: #fff; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; }
  @keyframes vb-entra { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .vb { animation: none; } }
</style>
