---
// Landing pública. Lee todo de D1 en cada request: lo que el comité aprueba aparece al instante.
// Primero el directorio con todos (buscar por nombre o categoría). La feria (índice, vitrina y
// sección por conjunto) solo aparece si el comité activó una fecha que aún no pasa.
// La usan `/` y `/e/<slug>` (link para compartir: abre la ficha de ese emprendimiento).
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import IndiceTorres from './IndiceTorres.astro';
import VitrinaCarrusel from './VitrinaCarrusel.astro';
import Historia from './Historia.astro';
import TorreSection from './TorreSection.astro';
import ComoParticipar from './ComoParticipar.astro';
import UbicacionFechas from './UbicacionFechas.astro';
import ConElRespaldoDe from './ConElRespaldoDe.astro';
import PatrocinadorJuanCode from './PatrocinadorJuanCode.astro';
import Footer from './Footer.astro';
import DetalleModal from './DetalleModal.astro';
import Directorio from './Directorio.astro';
import CartelFeria from './CartelFeria.astro';
import RepartoConjuntos from './RepartoConjuntos.astro';
import { listarFechas, listarPatrocinadores, listarPublicos, listarTorres, ocupacion, repartoPublico, resumenCalificaciones, type EmprendedorPublico } from '../lib/db';
import { aceptaInscripciones, feriasActivas } from '../lib/fechas';
import { categoria } from '../lib/constantes';

interface Props {
  /** Emprendimiento cuya ficha se abre al cargar (link /e/<slug>). */
  abrir?: string;
  /** Meta para la vista previa al compartir (título, descripción, foto). */
  meta?: { title: string; description: string; image?: string };
  /** Si ya se cargaron (la ruta /e/ los necesita para validar el slug), se reusan. */
  publicos?: EmprendedorPublico[];
}
const { abrir, meta } = Astro.props;

const db = Astro.locals.runtime.env.DB;
const [torres, publicos, patrocinadores, todasLasFechas, calificaciones] = await Promise.all([
  listarTorres(db),
  Astro.props.publicos ?? listarPublicos(db),
  listarPatrocinadores(db),
  listarFechas(db),
  resumenCalificaciones(db),
]);

const fechas = feriasActivas(todasLasFechas);
const hayFeria = fechas.length > 0;
// Ferias itinerantes (con conjuntos): "en la feria" = aprobado y ubicado por el comité.
// Ferias del sistema anterior (sin conjuntos): sigue valiendo la marca `en_feria`.
const itinerantes = fechas.filter((f) => f.conjuntos?.length);
const hayLegado = fechas.some((f) => !f.conjuntos?.length);
const [reparto, ocupacionFerias] = await Promise.all([repartoPublico(db, itinerantes.map((f) => f.id)), ocupacion(db)]);
// Sin feria activa nadie lleva la etiqueta 🎪 (ni en el directorio ni en el modal).
const emprendedores = publicos.map((e) => ({ ...e, en_feria: reparto.has(e.slug) || (hayLegado && e.en_feria), calificacion: calificaciones[e.slug] }));

const enFeria = emprendedores.filter((e) => e.en_feria);
const porTorre = Object.fromEntries(torres.map((t) => [t.id, enFeria.filter((e) => e.torre === t.id)]));
const conteo = Object.fromEntries(torres.map((t) => [t.id, porTorre[t.id].length]));
// Reparto: conjuntos de las ferias itinerantes activas y quién vende en cada uno.
const conjuntosReparto = torres.filter((t) => itinerantes.some((f) => f.conjuntos!.includes(t.id)));
const porConjunto = Object.fromEntries(torres.map((t) => [t.id, emprendedores.filter((e) => reparto.get(e.slug) === t.id)]));
// Vitrina "Feria · <fecha>": todos los de la feria uno a uno (destacados primero); si nadie está en la feria, todos.
const baseVitrina = enFeria.length ? enFeria : emprendedores;
// Teclado del citófono: categorías con al menos un emprendimiento (un id desconocido cuenta como "Otros").
const catDe = (id: string) => categoria(id, Astro.locals.categorias);
const teclas = Astro.locals.categorias
  .map((c) => ({ id: c.id, label: c.label, n: emprendedores.filter((e) => catDe(e.categoria).id === c.id).length }))
  .filter((c) => c.n > 0);
// Primer vistazo: fotos reales de emprendimientos (primero los que tienen foto; destacados y nuevos van adelante).
const vitrinaHero = [...emprendedores.filter((e) => e.foto_principal), ...emprendedores.filter((e) => !e.foto_principal)].slice(0, 4);

// Sin caché: lo que el comité publica se ve apenas se recarga la página.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title={meta?.title} description={meta?.description} image={meta?.image}>
  <Nav torres={torres} feria={hayFeria} />
  <main>
    <CartelFeria ferias={fechas} torres={torres} ocupacion={ocupacionFerias} />
    {/* El cartel de arriba ya anuncia la feria: el aviso del Hero solo queda para ferias del sistema anterior. */}
    {/* Con feria itinerante, la feria va primero y el directorio de todo el año pasa a segundo plano. */}
    {conjuntosReparto.length > 0 && <RepartoConjuntos torres={torres} conjuntos={torres} participan={conjuntosReparto.map((t) => t.id)} porConjunto={porConjunto} />}
    <Hero
      proxima={fechas.length && !itinerantes.length ? fechas[0] : undefined}
      torres={torres}
      total={emprendedores.length}
      teclas={teclas}
      feria={enFeria.length > 0}
      vitrina={vitrinaHero}
      secundario={conjuntosReparto.length > 0}
    />
    <Directorio emprendedores={emprendedores} torres={torres} />
    {
      hayFeria && !conjuntosReparto.length && (
        <>
          <IndiceTorres torres={torres} conteo={conteo} />
          {enFeria.length > 0 && <VitrinaCarrusel emprendedores={baseVitrina} torres={torres} proxima={fechas[0]} />}
        </>
      )
    }
    <Historia />
    {hayFeria && !conjuntosReparto.length && torres.map((t) => <TorreSection torre={t} emprendedores={porTorre[t.id]} />)}
    <ComoParticipar feria={fechas.find((f) => aceptaInscripciones(f))} />
    <UbicacionFechas fechas={fechas} torres={torres} />
    <ConElRespaldoDe patrocinadores={patrocinadores} />
    <PatrocinadorJuanCode />
  </main>
  <Footer torres={torres} feria={hayFeria} />
  <DetalleModal emprendedores={emprendedores} torres={torres} abrir={abrir} />
</Layout>
