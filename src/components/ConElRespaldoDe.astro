---
// Quienes respaldan la feria, como hojas pegadas al muro. La destacada (Alcaldía) va más grande.
import type { Patrocinador } from '../lib/db';

interface Props {
  patrocinadores: Patrocinador[];
}
const { patrocinadores } = Astro.props;
const STOCK: Record<Patrocinador['tipo'], string> = {
  oficial: 'var(--lila)',
  comunitario: 'var(--menta)',
  cultural: 'var(--papel)',
};
---

<section class="respaldo" id="respaldo" aria-labelledby="respaldo-titulo">
  <div class="wrap">
    <h2 id="respaldo-titulo">Con el respaldo de</h2>
    <p class="bajada">La feria existe gracias a la comunidad, las instituciones y los aliados que creen en el emprendimiento del barrio.</p>

    <div class="respaldo-grid">
      {
        patrocinadores.map((p, i) => (
          <div class:list={['sello-hoja', { principal: p.destacado }]} style={`--stock:${STOCK[p.tipo]};--rr:${[-1.2, 0.9, -0.5][i % 3]}deg`}>
            <span class="grapa" style="top:-3px;left:calc(50% - 13px)" />
            <p class="sello etiqueta">{p.etiqueta}</p>
            {p.logo && <img class="logo" src={p.logo} alt={`Logo de ${p.nombre}`} loading="lazy" />}
            <h3>{p.nombre}</h3>
            <p class="desc">{p.descripcion}</p>
            <p class="sello rol">{p.rol_corto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .respaldo { padding: 30px 0 110px; }
  h2 { font-size: clamp(52px, 7vw, 104px); margin-bottom: 14px; }
  .bajada { font-family: var(--f-sello); font-size: 16.5px; max-width: 60ch; margin-bottom: 40px; }
  .respaldo-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 28px; align-items: start; }
  @media (max-width: 900px) { .respaldo-grid { grid-template-columns: 1fr; } }
  .sello-hoja {
    position: relative; display: flex; flex-direction: column;
    background: var(--stock); padding: 30px 26px 24px;
    transform: rotate(var(--rr));
    box-shadow: var(--sombra-papel);
  }
  .etiqueta { font-size: 12.5px; margin-bottom: 14px; }
  .logo { height: 84px; width: auto; max-width: 100%; align-self: flex-start; object-fit: contain; margin-bottom: 16px; background: #fff; padding: 6px; }
  h3 { font-size: 34px; margin-bottom: 8px; }
  .principal h3 { font-size: 46px; }
  .desc { font-size: 15.5px; line-height: 1.5; margin-bottom: 16px; }
  .rol { font-size: 12.5px; padding-top: 12px; border-top: 2px solid var(--xerox); }
</style>
