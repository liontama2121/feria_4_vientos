---
// Primer vistazo = el panel del citófono de la portería: la pantalla LCD es el buscador
// (#dirBuscar) y el teclado son las categorías. Directorio.astro escucha ambos.
import Molinete from './Molinete.astro';
import type { Fecha, Torre } from '../lib/db';
import { diaMes, rangoHoras } from '../lib/fechas';

interface Props {
  proxima: Fecha | undefined;
  torres: Torre[];
  /** Emprendimientos publicados (dato real). */
  total: number;
  /** Categorías con al menos un emprendimiento. */
  teclas: { id: string; label: string; n: number }[];
  /** Hay emprendimientos marcados "en la feria" y una feria activa. */
  feria: boolean;
}
const { proxima, torres, total, teclas, feria } = Astro.props;
const nombres = torres.map((t) => t.nombre);
const listaTorres = `${nombres.slice(0, -1).join(', ')} y ${nombres.at(-1)}`;
const fecha = proxima ? diaMes(proxima.fecha) : null;
---

<header class="hero">
  <div class="wrap">
    <div class="panel placa tornillos encender">
      <div class="panel-principal">
        <h1 class="grabado">Encuentra a tu vecino</h1>
        <p class="bajada">Emprendimientos de {listaTorres}. Búscalo aquí y llámalo por WhatsApp.</p>

        <form class="pantalla lcd" action="#muro" role="search" data-buscar-hero>
          <label for="dirBuscar" class="pantalla-linea">¿A quién buscas?</label>
          <div class="pantalla-fila">
            <span class="prompt" aria-hidden="true">&gt;</span>
            <input id="dirBuscar" type="search" name="q" placeholder="arepas, plomero, uñas" autocomplete="off" enterkeyhint="search" />
            <button type="submit" class="tecla tecla-buscar">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
              Buscar
            </button>
          </div>
        </form>

        <div class="teclado" role="group" aria-label="Filtrar por categoría">
          <button type="button" class="tecla" data-filtro-cat="" aria-pressed="true">
            Todas <span class="n">{total}</span>
          </button>
          {
            teclas.map((c) => (
              <button type="button" class="tecla" data-filtro-cat={c.id} aria-pressed="false">
                {c.label} <span class="n">{c.n}</span>
              </button>
            ))
          }
          {
            feria && (
              <button type="button" class="tecla tecla-feria" id="dirSoloFeria" aria-pressed="false">
                Solo en la feria
              </button>
            )
          }
        </div>
      </div>

      <div class="panel-lateral">
        <div class="parlante" aria-hidden="true"></div>
        <Molinete size={120} label="Molinete de 4 Vientos" />
        <div class="contador lcd" aria-label={`${total} emprendimientos en el directorio`}>
          <span class="contador-num">{String(total).padStart(3, '0')}</span>
          <span class="contador-txt">vecinos en el directorio</span>
        </div>
        {
          proxima && fecha && (
            <a href="#torres" class="aviso-feria lcd">
              <span>Próxima feria</span>
              <span class="aviso-fecha">
                {fecha.dd} {fecha.mm}
              </span>
              <span>{rangoHoras(proxima)}</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  // Buscar desde la pantalla: el filtro corre en vivo (Directorio.astro); al enviar, baja a la lista.
  document.querySelector<HTMLFormElement>('[data-buscar-hero]')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    document.getElementById('muro')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>

<style>
  .hero { padding: 28px 0 40px; }
  .panel {
    display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 36px;
    padding: 52px 52px 48px;
  }
  @media (max-width: 960px) { .panel { grid-template-columns: 1fr; gap: 28px; padding: 44px 22px 40px; } }

  h1 { font-size: clamp(52px, 7.6vw, 112px); margin-bottom: 14px; }
  .bajada { font-size: 19px; max-width: 48ch; margin-bottom: 26px; color: var(--grafito-suave); font-weight: 500; }

  .pantalla { padding: 16px 18px 18px; margin-bottom: 26px; }
  .pantalla-linea { display: block; font-size: 28px; line-height: 1; margin-bottom: 8px; text-transform: uppercase; }
  .pantalla-fila { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .prompt { font-size: 38px; line-height: 1; animation: parpadeo 1.1s steps(2) infinite; }
  @keyframes parpadeo { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .prompt { animation: none; } }
  .pantalla input {
    flex: 1 1 220px; min-width: 0; min-height: 52px;
    font-family: var(--f-lcd); font-size: 36px; color: var(--lcd);
    background: rgba(184, 233, 134, .06); border: 0; border-bottom: 2px dashed rgba(184, 233, 134, .5); border-radius: 0;
    padding: 4px 6px; caret-color: var(--lcd);
  }
  .pantalla input::placeholder { color: rgba(184, 233, 134, .6); }
  .pantalla input:focus-visible { outline: 2px solid var(--lcd); outline-offset: 2px; box-shadow: none; }
  .tecla-buscar { min-height: 52px; }

  .panel-principal, .panel-lateral { min-width: 0; }
  .teclado { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px 12px; }
  @media (max-width: 520px) { .teclado { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 10px; } }
  .teclado .tecla { justify-content: space-between; font-size: 19px; white-space: normal; text-align: left; min-width: 0; }
  @media (max-width: 520px) { .teclado .tecla { font-size: 17px; padding: 10px 12px; } }
  .n { font-family: var(--f-lcd); font-size: 22px; opacity: .8; }
  .tecla-feria[aria-pressed='true'] { background: linear-gradient(180deg, var(--luz), var(--luz-fuerte)); }

  .panel-lateral { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  @media (max-width: 960px) {
    .panel-lateral { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .parlante, .panel-lateral :global(.molinete) { display: none; }
  }
  .parlante {
    width: 170px; height: 170px; border-radius: 50%;
    background: radial-gradient(circle, var(--grafito) 0 2.4px, transparent 3px) 0 0 / 13px 13px, linear-gradient(180deg, #B4BBC0, #A3AAAF);
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, .35), 0 1px 0 rgba(255, 255, 255, .7);
  }
  .contador { display: flex; align-items: center; gap: 12px; padding: 12px 16px; width: 100%; max-width: 280px; }
  .contador-num { font-size: 64px; line-height: .8; letter-spacing: .04em; }
  .contador-txt { font-size: 22px; line-height: 1; text-transform: uppercase; }
  .aviso-feria { display: grid; gap: 2px; width: 100%; max-width: 280px; padding: 12px 16px; font-size: 22px; line-height: 1; text-transform: uppercase; }
  .aviso-fecha { font-size: 48px; }
  .aviso-feria:hover { color: var(--luz); }
</style>
