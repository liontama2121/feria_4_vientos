---
import Molinete from './Molinete.astro';
import type { Fecha, Torre } from '../lib/db';
import { fechaLarga, rangoHoras } from '../lib/fechas';

interface Props {
  proxima: Fecha | undefined;
  torres: Torre[];
}
const { proxima, torres } = Astro.props;
const nombres = torres.map((t) => t.nombre);
const listaTorres = `${nombres.slice(0, -1).join(', ')} y ${nombres.at(-1)}`;
---

<header class="hero">
  <div class="malla" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="hero-eyebrow">
        <span class="dot"></span>
        {proxima ? `Próxima feria · ${fechaLarga(proxima.fecha)} · ${rangoHoras(proxima)}` : 'Muy pronto, nueva fecha'}
      </span>
      <h1>Cuatro <span class="serif grad-text">vientos</span>, un mismo conjunto.</h1>
      <p class="lead">
        La feria de emprendimientos donde cada torre — <strong>{listaTorres}</strong> — trae lo suyo al espacio que recuperamos para la comunidad.
      </p>
      <div class="cta-row">
        <a href="#torres" class="btn btn-primary">Ver los 4 vientos →</a>
        <a href="#participar" class="btn btn-ghost">Quiero participar</a>
      </div>
    </div>

    <div class="hero-logo">
      <Molinete size={260} spin label="Molinete de la Feria 4 Vientos" />
      <div class="marca">FERIA 4 VIENTOS</div>
      <div class="vientos">{nombres.join(' · ').toUpperCase()}</div>
    </div>
  </div>
</header>

<style>
  .hero { position: relative; padding: 90px 0 120px; overflow: hidden; background: var(--crema); }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background-image: radial-gradient(circle, rgba(26, 22, 51, .05) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }
  .malla { position: absolute; inset: 0; overflow: hidden; }
  .malla i { position: absolute; width: 560px; height: 560px; border-radius: 50%; filter: blur(110px); opacity: .42; animation: deriva 12s ease-in-out infinite; }
  .malla i:nth-child(1) { background: var(--mistral); left: -180px; top: -200px; }
  .malla i:nth-child(2) { background: var(--gregal); right: -160px; top: -240px; animation-delay: -4s; }
  .malla i:nth-child(3) { background: var(--austro); left: 18%; bottom: -380px; animation-delay: -2s; }
  .malla i:nth-child(4) { background: var(--cierzo); right: 4%; bottom: -340px; animation-delay: -8s; }
  @keyframes deriva { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-30px, 24px); } }

  .hero-inner { display: grid; grid-template-columns: 1.15fr 1fr; gap: 60px; align-items: center; z-index: 2; }
  @media (max-width: 920px) { .hero-inner { grid-template-columns: 1fr; text-align: center; } .hero-logo { order: -1; } }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 18px; margin-bottom: 24px;
    background: #fff; border-radius: 999px;
    font-size: 13.5px; font-weight: 700;
    box-shadow: 0 10px 26px rgba(26, 22, 51, .1);
  }
  .hero-eyebrow .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--gregal); box-shadow: 0 0 12px var(--gregal); flex: 0 0 auto; }

  h1 { font-size: clamp(46px, 6.5vw, 86px); line-height: 1.02; letter-spacing: -.035em; margin-bottom: 22px; }
  .lead { font-size: 19px; color: var(--tinta-media); max-width: 520px; margin-bottom: 32px; }
  .lead strong { color: var(--tinta); }
  @media (max-width: 920px) { .lead { margin-left: auto; margin-right: auto; } }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  @media (max-width: 920px) { .cta-row { justify-content: center; } }

  .hero-logo { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero-logo :global(.molinete) { filter: drop-shadow(0 24px 50px rgba(123, 63, 228, .3)); width: min(260px, 60vw); height: auto; }
  .marca { font-family: var(--display); font-weight: 800; font-size: 28px; letter-spacing: .2em; margin-top: 26px; }
  .vientos { font-size: 11px; letter-spacing: .3em; color: var(--tinta-suave); font-weight: 700; margin-top: 6px; }
</style>
