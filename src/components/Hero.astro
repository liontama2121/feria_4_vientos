---
// Primer vistazo = la entrada de la plaza: toldo de rayas, el letrero "¿Qué se le ofrece,
// vecino?" con el buscador (#dirBuscar) y las etiquetas de categoría, y al lado fotos REALES
// de emprendimientos como la mercancía del puesto. Directorio.astro escucha buscador y etiquetas.
import type { EmprendedorPublico, Fecha, Torre } from '../lib/db';
import { fechaLarga, rangoHoras } from '../lib/fechas';
import { iniciales } from '../lib/constantes';

interface Props {
  proxima: Fecha | undefined;
  torres: Torre[];
  /** Emprendimientos publicados (dato real). */
  total: number;
  /** Categorías con al menos un emprendimiento. */
  teclas: { id: string; label: string; n: number }[];
  /** Hay emprendimientos marcados "en la feria" y una feria activa. */
  feria: boolean;
  /** Hasta 4 emprendimientos para la vitrina del puesto (primero los que tienen foto). */
  vitrina: EmprendedorPublico[];
}
const { proxima, torres, total, teclas, feria, vitrina } = Astro.props;
const nombres = torres.map((t) => t.nombre);
const listaTorres = `${nombres.slice(0, -1).join(', ')} y ${nombres.at(-1)}`;
const GIROS = [-4, 3, -2, 5];
---

<header class="hero">
  <div class="toldo toldo-grande" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy abrir">
      <h1>¿Qué se le ofrece, vecino?</h1>
      <p class="bajada">Lo que hacen y venden los vecinos de {listaTorres}. Búsquelo y pídalo por WhatsApp.</p>

      <form class="buscar" action="#muro" role="search" data-buscar-hero>
        <label for="dirBuscar" class="buscar-label">¿Qué busca?</label>
        <div class="buscar-fila">
          <input id="dirBuscar" type="search" name="q" placeholder="arepas, plomero, uñas, tortas…" autocomplete="off" enterkeyhint="search" />
          <button type="submit" class="boton boton-tinta">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
            Buscar
          </button>
        </div>
      </form>

      <div class="etiquetas" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="etiqueta cat" data-filtro-cat="" aria-pressed="true">
          Todo <span class="n">{total}</span>
        </button>
        {
          teclas.map((c, i) => (
            <button type="button" class="etiqueta cat" data-filtro-cat={c.id} aria-pressed="false" style={`--g:${[-2, 1.5, -1, 2.5, -1.5][i % 5]}deg`}>
              {c.label} <span class="n">{c.n}</span>
            </button>
          ))
        }
        {
          feria && (
            <button type="button" class="etiqueta cat cat-feria" id="dirSoloFeria" aria-pressed="false">
              Solo los de la feria
            </button>
          )
        }
      </div>
    </div>

    <div class="puesto-vitrina" aria-label="Algunos emprendimientos del directorio">
      {
        vitrina.map((e, i) => {
          const t = torres.find((x) => x.id === e.torre) ?? torres[0];
          return (
            <button type="button" class="producto abrir" data-detalle={e.slug} data-conjunto={t.id} style={`--g:${GIROS[i % 4]}deg;--i:${i + 1}`}>
              {e.foto_principal ? (
                <img src={e.foto_principal} alt={`Foto de ${e.nombre_emprendimiento}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
              ) : (
                <span class="producto-iniciales" aria-hidden="true">
                  {iniciales(e.nombre_emprendimiento || e.nombre_vecino)}
                </span>
              )}
              <span class="etiqueta producto-nombre">{e.nombre_emprendimiento}</span>
            </button>
          );
        })
      }
      <p class="conteo">
        <span class="conteo-num">{total}</span> {total === 1 ? 'emprendimiento' : 'emprendimientos'} en la plaza
      </p>
    </div>
  </div>

  {
    proxima && (
      <div class="wrap">
        <a href="#torres" class="aviso-feria letrero">
          <span class="aviso-titulo">¡Hay feria!</span>
          <span>
            {fechaLarga(proxima.fecha)} · {rangoHoras(proxima)} · El terminalito
          </span>
        </a>
      </div>
    )
  }
</header>

<script>
  // Buscar desde el letrero: el filtro corre en vivo (Directorio.astro); al enviar, baja a los puestos.
  document.querySelector<HTMLFormElement>('[data-buscar-hero]')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    document.getElementById('muro')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>

<style>
  .hero { background: var(--mango); padding-bottom: 40px; }
  .toldo-grande { --t1: var(--pitahaya); --ancho: 56px; --feston: 20px; height: 70px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 40px; align-items: center; padding-top: 22px; }
  @media (max-width: 920px) { .hero-grid { grid-template-columns: 1fr; gap: 30px; } }

  h1 { font-size: clamp(52px, 7vw, 100px); line-height: .95; margin-bottom: 16px; color: var(--tinta); }
  .bajada { font-size: 20px; font-weight: 600; max-width: 38ch; margin-bottom: 24px; }

  .buscar { margin-bottom: 22px; }
  .buscar-label { display: block; font-family: var(--f-mano); font-size: 28px; line-height: 1; margin-bottom: 6px; }
  .buscar-fila { display: flex; gap: 10px; flex-wrap: wrap; }
  .buscar input {
    flex: 1 1 260px; min-width: 0; min-height: 58px;
    padding: 12px 22px; border-radius: 999px;
    font: inherit; font-size: 19px; font-weight: 600; color: var(--tinta);
    background: var(--papel); border: 3px solid var(--tinta);
  }
  .buscar input::placeholder { color: #6A6480; font-weight: 500; }
  .buscar .boton { min-height: 58px; }

  .etiquetas { display: flex; flex-wrap: wrap; gap: 10px 10px; }
  .cat { transform: rotate(var(--g, 0deg)); border: 0; cursor: pointer; min-height: 44px; transition: transform .35s var(--ease), background .2s ease; }
  .cat:hover { transform: rotate(0) translateY(-2px); }
  .cat[aria-pressed='true'] { background: var(--tinta); color: var(--mango); transform: rotate(0) scale(1.05); }
  .cat[aria-pressed='true']::before { background: var(--mango); }
  .n { font-family: var(--f-texto); font-weight: 800; font-size: 15px; opacity: .75; }
  .cat-feria[aria-pressed='true'] { background: var(--pitahaya); color: #fff; }

  /* La mercancía del puesto: fotos reales, grandes y a color */
  .puesto-vitrina { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; position: relative; }
  .producto {
    position: relative; padding: 8px 8px 0; border: 0; cursor: pointer;
    background: var(--papel); border-radius: 14px;
    transform: rotate(var(--g));
    box-shadow: var(--sombra-alta);
    transition: transform .35s var(--ease);
  }
  .producto:nth-child(2), .producto:nth-child(4) { margin-top: 26px; }
  .producto:hover { transform: rotate(0) translateY(-4px) scale(1.02); z-index: 2; }
  .producto img, .producto-iniciales { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; }
  .producto-iniciales { display: grid; place-items: center; background: var(--c); color: #fff; font-family: var(--f-letrero); font-size: 64px; }
  .producto-nombre { position: relative; top: -14px; margin: 0 auto -8px; font-size: 20px; max-width: 92%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: flex; }
  .conteo { grid-column: 1 / -1; text-align: center; font-family: var(--f-mano); font-size: 26px; line-height: 1.1; }
  .conteo-num { font-family: var(--f-letrero); font-size: 44px; color: var(--pitahaya); }
  @media (max-width: 920px) { .puesto-vitrina { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; } .producto:nth-child(2), .producto:nth-child(4) { margin-top: 12px; } .producto-nombre { display: none; } }
  @media (max-width: 520px) { .puesto-vitrina { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .aviso-feria {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    margin-top: 30px; padding: 16px 24px; font-weight: 700; font-size: 18px;
    background: var(--pitahaya); color: #fff; border-color: var(--tinta);
    transform: rotate(-1deg); transition: transform .3s var(--ease);
  }
  .aviso-feria:hover { transform: rotate(0) translateY(-2px); }
  .aviso-titulo { font-family: var(--f-letrero); font-size: 38px; line-height: 1; }
</style>
