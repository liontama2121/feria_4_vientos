---
// Convocatoria para vecinos con emprendimiento: "Ponga su puesto en la plaza".
// Refleja el flujo real: registro → el comité activa la cuenta → llena su ficha → aprobación.
import { LIMITES } from '../lib/constantes';
import { MENSAJES, linkWhatsApp } from '../lib/sitio';

const pasos = [
  { t: 'Cree su cuenta', d: 'En el registro, con su correo, su conjunto y su WhatsApp.' },
  { t: 'El comité la activa', d: 'Le avisamos por WhatsApp cuando pueda entrar.' },
  { t: 'Arme su puesto', d: `Nombre, qué ofrece, hasta ${LIMITES.galeria + 1} fotos y sus redes.` },
  { t: 'Abre en la plaza', d: 'Cuando el comité lo aprueba, cualquier vecino lo encuentra y le escribe.' },
];
const COLORES = ['var(--lulo)', 'var(--pitahaya)', 'var(--mora)', 'var(--hierbabuena)'];
---

<section class="participar" id="participar" aria-labelledby="participar-titulo">
  <div class="wrap">
    <div class="convocatoria letrero">
      <div class="toldo" style="--t1:var(--lulo)" aria-hidden="true"></div>
      <div class="conv-grid">
        <div>
          <h2 id="participar-titulo">Ponga su puesto en la plaza</h2>
          <p class="bajada">Si vive en uno de los 4 conjuntos y tiene un emprendimiento, publíquelo gratis. Sin inscripción, sin comisiones.</p>
          <div class="acciones">
            <a href="/registro" class="boton boton-tinta">Registrar mi emprendimiento</a>
            <a href={linkWhatsApp(MENSAJES.participar)} class="enlace-comite" target="_blank" rel="noopener">¿Dudas? Escríbale al comité</a>
          </div>
        </div>
        <ol class="pasos">
          {
            pasos.map((p, i) => (
              <li class="paso">
                <span class="num" style={`background:${COLORES[i]}`} aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3>{p.t}</h3>
                  <p>{p.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .participar { padding: 0 0 90px; scroll-margin-top: 64px; }
  .convocatoria { overflow: hidden; }
  .conv-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: center; padding: 30px 44px 44px; }
  @media (max-width: 900px) { .conv-grid { grid-template-columns: 1fr; padding: 24px 20px 32px; gap: 30px; } }
  h2 { font-size: clamp(44px, 5.4vw, 76px); margin-bottom: 16px; }
  .bajada { font-size: 18px; max-width: 44ch; margin-bottom: 26px; }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .enlace-comite { font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; min-height: 44px; display: inline-flex; align-items: center; }
  .pasos { list-style: none; display: grid; gap: 16px; }
  .paso { display: flex; gap: 16px; align-items: flex-start; }
  .num { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-family: var(--f-letrero); font-size: 26px; }
  .paso h3 { font-size: 26px; margin-bottom: 2px; }
  .paso p { font-size: 16px; line-height: 1.45; color: var(--tinta-suave); }
</style>
