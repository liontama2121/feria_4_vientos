---
// Convocatoria para vecinos con emprendimiento. Refleja el flujo real: registro → el comité
// activa la cuenta → el vecino llena su aviso → el comité lo aprueba y sale en el muro.
import { LIMITES } from '../lib/constantes';
import { MENSAJES, linkWhatsApp } from '../lib/sitio';

const pasos = [
  { t: 'Crea tu cuenta', d: 'En el registro, con tu correo, tu conjunto y tu WhatsApp.' },
  { t: 'El comité la activa', d: 'Te avisamos por WhatsApp cuando puedas entrar.' },
  { t: 'Llena tu aviso', d: `Nombre, qué ofreces, hasta ${LIMITES.galeria + 1} fotos y tus redes.` },
  { t: 'Sale en el muro', d: 'Cuando el comité lo aprueba, cualquier vecino te encuentra y te escribe.' },
];
---

<section class="participar" id="participar" aria-labelledby="participar-titulo">
  <div class="wrap">
    <div class="convocatoria con-sombra">
      <div class="hoja rasgado-ambos convocatoria-papel perforado">
        <span class="grapa" style="top:22px;left:50%;--g-rot:4deg"></span>
        <div class="conv-grid">
          <div>
            <h2 id="participar-titulo">Pega tu aviso en el muro</h2>
            <p class="bajada">Si vives en uno de los 4 conjuntos y tienes un emprendimiento, publícalo gratis. Sin inscripción, sin comisiones.</p>
            <div class="acciones">
              <a href="/registro" class="boton boton-tinta">Registrar mi emprendimiento</a>
              <a href={linkWhatsApp(MENSAJES.participar)} class="enlace-comite sello" target="_blank" rel="noopener">¿Dudas? Escríbele al comité</a>
            </div>
          </div>
          <ol class="pasos">
            {
              pasos.map((p, i) => (
                <li class="paso" style={`--rp:${i % 2 ? 0.8 : -0.7}deg`}>
                  <span class="num" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <h3>{p.t}</h3>
                    <p>{p.d}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .participar { padding: 30px 0 110px; scroll-margin-top: 64px; }
  .convocatoria-papel {
    --stock: var(--naranja); --borde-alto: 20px;
    padding: 72px 48px 60px 64px;
    background-position: 20px 0;
    transform: rotate(.6deg);
  }
  @media (max-width: 700px) { .convocatoria-papel { padding: 60px 20px 48px 40px; background-position: 10px 0; } }
  .conv-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 900px) { .conv-grid { grid-template-columns: 1fr; gap: 36px; } }
  h2 { font-size: clamp(56px, 7.6vw, 112px); margin-bottom: 20px; }
  .bajada { font-family: var(--f-sello); font-size: 17px; line-height: 1.5; max-width: 42ch; margin-bottom: 28px; }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .enlace-comite { font-size: 14px; text-decoration: underline; text-decoration-thickness: 2px; min-height: 44px; display: inline-flex; align-items: center; }

  .pasos { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .paso {
    display: flex; gap: 16px; align-items: flex-start;
    background: var(--papel); padding: 16px 18px;
    transform: rotate(var(--rp));
    box-shadow: var(--sombra-papel);
  }
  .num {
    flex: 0 0 auto; width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    background: var(--xerox); color: var(--verde);
    font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 30px; line-height: 1;
  }
  .paso h3 { font-size: 30px; margin-bottom: 4px; }
  .paso p { font-size: 15.5px; line-height: 1.45; }
</style>
