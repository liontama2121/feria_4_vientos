---
// Convocatoria para vecinos con emprendimiento, como la tarjeta de instrucciones del citófono.
// Refleja el flujo real: registro → el comité activa la cuenta → llena su ficha → aprobación.
import { LIMITES } from '../lib/constantes';
import { MENSAJES, linkWhatsApp } from '../lib/sitio';

const pasos = [
  { t: 'Crea tu cuenta', d: 'En el registro, con tu correo, tu conjunto y tu WhatsApp.' },
  { t: 'El comité la activa', d: 'Te avisamos por WhatsApp cuando puedas entrar.' },
  { t: 'Llena tu ficha', d: `Nombre, qué ofreces, hasta ${LIMITES.galeria + 1} fotos y tus redes.` },
  { t: 'Sales en el directorio', d: 'Cuando el comité lo aprueba, cualquier vecino te encuentra y te llama.' },
];
---

<section class="participar" id="participar" aria-labelledby="participar-titulo">
  <div class="wrap">
    <div class="instrucciones placa tornillos">
      <div class="inst-copy">
        <h2 id="participar-titulo" class="grabado">Pon tu emprendimiento en el directorio</h2>
        <p class="bajada">Si vives en uno de los 4 conjuntos, publícalo gratis. Sin inscripción, sin comisiones.</p>
        <div class="acciones">
          <a href="/registro" class="boton boton-tinta">Registrar mi emprendimiento</a>
          <a href={linkWhatsApp(MENSAJES.participar)} class="enlace-comite" target="_blank" rel="noopener">¿Dudas? Escríbele al comité</a>
        </div>
      </div>
      <ol class="tarjeta">
        <li class="tarjeta-titulo rotulo" aria-hidden="true">Instrucciones</li>
        {
          pasos.map((p, i) => (
            <li class="paso">
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .participar { padding: 20px 0 100px; scroll-margin-top: 64px; }
  .instrucciones { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: center; padding: 56px 52px 50px; }
  @media (max-width: 900px) { .instrucciones { grid-template-columns: 1fr; padding: 46px 22px 40px; gap: 32px; } }
  h2 { font-size: clamp(44px, 5.4vw, 80px); margin-bottom: 16px; }
  .bajada { font-size: 18px; color: var(--grafito-suave); max-width: 44ch; margin-bottom: 26px; }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .enlace-comite { font-weight: 600; text-decoration: underline; min-height: 44px; display: inline-flex; align-items: center; }

  /* Tarjeta impresa detrás de acrílico */
  .tarjeta {
    list-style: none; padding: 18px 20px; border-radius: var(--r-plaquita);
    background: linear-gradient(180deg, #FFFFFF, #F4F5F2);
    box-shadow: inset 0 0 0 1px rgba(35, 39, 43, .2), 0 0 0 3px #9AA2A7, 0 0 0 4px #E9EDEF;
    display: grid; gap: 14px;
  }
  .tarjeta-titulo { font-size: 14px; padding-bottom: 8px; border-bottom: 2px solid var(--grafito); }
  .paso { display: flex; gap: 14px; align-items: flex-start; }
  .num {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--grafito); color: #F2F4F5; font-family: var(--f-placa); font-weight: 800; font-size: 22px;
  }
  .paso h3 { font-size: 24px; margin-bottom: 2px; }
  .paso p { font-size: 15.5px; line-height: 1.45; color: var(--grafito-suave); }
</style>
