---
// JuanCode patrocina SOLO el sitio web (no el evento): una calcomanía pegada en el muro.
import { SITIO } from '../lib/sitio';
---

<section class="juancode" aria-labelledby="juancode-titulo">
  <div class="wrap">
    <div class="calcomania">
      <p class="sello quien">Sitio web patrocinado por</p>
      <h2 id="juancode-titulo">JuanCode</h2>
      <p class="texto">
        La organización y el espacio los aportan la Alcaldía Local y las juntas de los cuatro conjuntos. Este muro, con el panel donde el comité publica cada emprendimiento, es
        cortesía de JuanCode.
      </p>
      {
        SITIO.juancodeUrl && (
          <a href={SITIO.juancodeUrl} class="boton" target="_blank" rel="noopener">
            Cotiza tu página web
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .juancode { padding: 10px 0 110px; }
  .calcomania {
    max-width: 760px; margin: 0 auto;
    display: grid; grid-template-columns: auto 1fr; gap: 6px 28px; align-items: center;
    background: var(--xerox); color: var(--papel);
    padding: 32px 36px;
    transform: rotate(-1.4deg);
    box-shadow: var(--sombra-papel-alta);
    border: 3px solid var(--papel);
    outline: 2px solid var(--xerox);
  }
  @media (max-width: 700px) { .calcomania { grid-template-columns: 1fr; padding: 26px 20px; } }
  .quien { grid-column: 1 / -1; font-size: 13px; color: var(--verde); }
  h2 { font-size: clamp(56px, 8vw, 104px); color: var(--papel); }
  .texto { font-size: 15.5px; line-height: 1.5; }
  .boton { grid-column: 1 / -1; justify-self: start; margin-top: 10px; }
</style>
