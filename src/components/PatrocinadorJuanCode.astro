---
// JuanCode patrocina SOLO el sitio web (no el evento): un letrerito del que pintó los letreros.
import { SITIO } from '../lib/sitio';
---

<section class="juancode" aria-labelledby="juancode-titulo">
  <div class="wrap">
    <div class="firma letrero">
      <p class="quien">Sitio web patrocinado por</p>
      <h2 id="juancode-titulo">JuanCode</h2>
      <p class="texto">
        La organización y el espacio los aportan la Alcaldía Local y las juntas de los cuatro conjuntos. Esta plaza en línea, con el panel donde el comité publica cada
        emprendimiento, es cortesía de JuanCode.
      </p>
      {
        SITIO.juancodeUrl && (
          <a href={SITIO.juancodeUrl} class="boton" target="_blank" rel="noopener">
            Cotice su página web
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .juancode { padding: 0 0 90px; }
  .firma {
    max-width: 780px; margin: 0 auto;
    display: grid; grid-template-columns: auto 1fr; gap: 6px 28px; align-items: center;
    padding: 28px 32px; background: var(--mora); color: #fff; border-color: var(--tinta);
    transform: rotate(-1deg);
  }
  @media (max-width: 700px) { .firma { grid-template-columns: 1fr; padding: 24px 20px; } }
  .quien { grid-column: 1 / -1; font-family: var(--f-mano); font-size: 24px; color: var(--mango); }
  h2 { font-size: clamp(48px, 7vw, 84px); }
  .texto { font-size: 16px; line-height: 1.5; }
  .boton { grid-column: 1 / -1; justify-self: start; margin-top: 10px; }
</style>
