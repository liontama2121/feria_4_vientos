---
// JuanCode patrocina SOLO el sitio web (no el evento): la placa del fabricante del citófono.
import { SITIO } from '../lib/sitio';
---

<section class="juancode" aria-labelledby="juancode-titulo">
  <div class="wrap">
    <div class="fabricante">
      <p class="rotulo quien">Sitio web patrocinado por</p>
      <h2 id="juancode-titulo">JuanCode</h2>
      <p class="texto">
        La organización y el espacio los aportan la Alcaldía Local y las juntas de los cuatro conjuntos. Este directorio, con el panel donde el comité publica cada
        emprendimiento, es cortesía de JuanCode.
      </p>
      {
        SITIO.juancodeUrl && (
          <a href={SITIO.juancodeUrl} class="boton" target="_blank" rel="noopener">
            Cotiza tu página web
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .juancode { padding: 0 0 100px; }
  .fabricante {
    max-width: 760px; margin: 0 auto;
    display: grid; grid-template-columns: auto 1fr; gap: 6px 28px; align-items: center;
    padding: 30px 34px; border-radius: 6px;
    background: linear-gradient(180deg, #2F353A, var(--grafito));
    color: #E9EDEF;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 0 0 3px var(--acero-borde), 0 14px 24px -14px rgba(0, 0, 0, .6);
  }
  @media (max-width: 700px) { .fabricante { grid-template-columns: 1fr; padding: 26px 20px; } }
  .quien { grid-column: 1 / -1; font-size: 13px; color: var(--luz); }
  h2 { font-size: clamp(48px, 7vw, 88px); color: #F2F4F5; letter-spacing: .04em; }
  .texto { font-size: 16px; line-height: 1.5; }
  .boton { grid-column: 1 / -1; justify-self: start; margin-top: 10px; }
</style>
