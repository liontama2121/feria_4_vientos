---
// Solo con feria activa: los 4 conjuntos como cartulinas con su nombre, rumbo y cuántos van a la feria.
import type { Torre } from '../lib/db';

interface Props {
  torres: Torre[];
  conteo: Record<string, number>;
}
const { torres, conteo } = Astro.props;
---

<section class="indice" id="torres" aria-labelledby="indice-titulo">
  <div class="wrap">
    <h2 id="indice-titulo">En la feria, por conjunto</h2>
    <div class="conjuntos">
      {
        torres.map((t, i) => (
          <a href={`#${t.id}`} class="conjunto" data-conjunto={t.id} style={`--rc:${[-1.4, 1, -0.6, 1.3][i % 4]}deg`}>
            <span class="grapa" style="top:-3px;left:22px" />
            <span class="nombre">{t.nombre}</span>
            <span class="sello rumbo">{t.rumbo}</span>
            <span class="sello conteo">{conteo[t.id] ?? 0} en la feria</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .indice { padding: 40px 0 70px; scroll-margin-top: 64px; }
  h2 { font-size: clamp(48px, 6.4vw, 96px); margin-bottom: 34px; }
  .conjuntos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  @media (max-width: 900px) { .conjuntos { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .conjuntos { grid-template-columns: 1fr; } }
  .conjunto {
    position: relative; display: flex; flex-direction: column; gap: 4px;
    min-height: 190px; padding: 30px 22px 22px;
    background: var(--stock); color: var(--xerox);
    transform: rotate(var(--rc)); box-shadow: var(--sombra-papel);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .conjunto:hover { transform: rotate(0) translateY(-4px); box-shadow: var(--sombra-papel-alta); }
  .nombre { font-family: var(--f-display); font-stretch: 62%; font-weight: 900; font-size: 64px; text-transform: uppercase; line-height: .85; }
  .rumbo { font-size: 13px; margin-bottom: auto; }
  .conteo { margin-top: 18px; align-self: flex-start; background: var(--xerox); color: var(--stock); padding: 6px 10px 4px; font-size: 13px; }
</style>
