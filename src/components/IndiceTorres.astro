---
// Solo con feria activa: los 4 conjuntos como pasillos de la plaza, con nombre, rumbo y cuántos van.
import type { Torre } from '../lib/db';

interface Props {
  torres: Torre[];
  conteo: Record<string, number>;
}
const { torres, conteo } = Astro.props;
---

<section class="indice" id="torres" aria-labelledby="indice-titulo">
  <div class="wrap">
    <h2 id="indice-titulo">En la feria, por conjunto</h2>
    <div class="conjuntos">
      {
        torres.map((t) => (
          <a href={`#${t.id}`} class="pasillo" data-conjunto={t.id}>
            <span class="toldo" aria-hidden="true" />
            <span class="cuerpo">
              <span class="nombre">{t.nombre}</span>
              <span class="rumbo">{t.rumbo}</span>
              <span class="etiqueta conteo">{conteo[t.id] ?? 0} en la feria</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .indice { padding: 0 0 80px; scroll-margin-top: 64px; }
  h2 { font-size: clamp(40px, 5vw, 72px); margin-bottom: 28px; }
  .conjuntos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  @media (max-width: 900px) { .conjuntos { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .conjuntos { grid-template-columns: 1fr; } }
  .pasillo { display: flex; flex-direction: column; background: var(--c); color: #fff; border-radius: var(--r-puesto); overflow: hidden; box-shadow: var(--sombra); transition: transform .3s var(--ease); }
  .pasillo:hover { transform: translateY(-4px); }
  .pasillo .toldo { display: block; --t1: var(--c); --t2: #fff; --ancho: 28px; --feston: 12px; height: 40px; }
  .cuerpo { display: flex; flex-direction: column; gap: 4px; padding: 10px 20px 22px; }
  .nombre { font-family: var(--f-letrero); font-size: 44px; line-height: 1; }
  .rumbo { font-weight: 700; opacity: .92; margin-bottom: 12px; }
  .conteo { align-self: flex-start; transform: rotate(-2deg); }
</style>
