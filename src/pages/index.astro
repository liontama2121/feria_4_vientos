---
// Landing pública. Lee todo de D1 en cada request: lo que el comité aprueba aparece al instante.
// Primero el directorio con todos (buscar por nombre o categoría). La feria (índice, vitrina y
// sección por conjunto) solo aparece si el comité activó una fecha que aún no pasa.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IndiceTorres from '../components/IndiceTorres.astro';
import VitrinaCarrusel from '../components/VitrinaCarrusel.astro';
import Historia from '../components/Historia.astro';
import TorreSection from '../components/TorreSection.astro';
import ComoParticipar from '../components/ComoParticipar.astro';
import UbicacionFechas from '../components/UbicacionFechas.astro';
import ConElRespaldoDe from '../components/ConElRespaldoDe.astro';
import PatrocinadorJuanCode from '../components/PatrocinadorJuanCode.astro';
import Footer from '../components/Footer.astro';
import DetalleModal from '../components/DetalleModal.astro';
import Directorio from '../components/Directorio.astro';
import { listarFechas, listarPatrocinadores, listarPublicos, listarTorres } from '../lib/db';
import { feriasActivas } from '../lib/fechas';

const db = Astro.locals.runtime.env.DB;
const [torres, publicos, patrocinadores, todasLasFechas] = await Promise.all([
  listarTorres(db),
  listarPublicos(db),
  listarPatrocinadores(db),
  listarFechas(db),
]);

const fechas = feriasActivas(todasLasFechas);
const hayFeria = fechas.length > 0;
// Sin feria activa nadie lleva la etiqueta 🎪 (ni en el directorio ni en el modal).
const emprendedores = hayFeria ? publicos : publicos.map((e) => ({ ...e, en_feria: false }));

const enFeria = emprendedores.filter((e) => e.en_feria);
const porTorre = Object.fromEntries(torres.map((t) => [t.id, enFeria.filter((e) => e.torre === t.id)]));
const conteo = Object.fromEntries(torres.map((t) => [t.id, porTorre[t.id].length]));
// Vitrina "Feria · <fecha>": todos los de la feria uno a uno (destacados primero); si nadie está en la feria, todos.
const baseVitrina = enFeria.length ? enFeria : emprendedores;

// Sin caché: lo que el comité publica se ve apenas se recarga la página.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout>
  <Nav torres={torres} feria={hayFeria} />
  <main>
    <Hero proxima={fechas[0]} torres={torres} />
    <Directorio emprendedores={emprendedores} torres={torres} />
    {
      hayFeria && (
        <>
          <IndiceTorres torres={torres} conteo={conteo} />
          <VitrinaCarrusel emprendedores={baseVitrina} torres={torres} proxima={fechas[0]} />
        </>
      )
    }
    <Historia />
    {hayFeria && torres.map((t) => <TorreSection torre={t} emprendedores={porTorre[t.id]} />)}
    <ComoParticipar />
    <UbicacionFechas fechas={fechas} />
    <ConElRespaldoDe patrocinadores={patrocinadores} />
    <PatrocinadorJuanCode />
  </main>
  <Footer torres={torres} feria={hayFeria} />
  <DetalleModal emprendedores={emprendedores} torres={torres} />
</Layout>
